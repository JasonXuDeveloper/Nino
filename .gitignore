# Build output (.NET projects under src/, tests/, tools/ and benchmarks/; the Unity project has its own .gitignore)
bin/
obj/
/artifacts/
TestResults/
*.binlog
tests/Nino.UnitTests/*.rsp
**/BenchmarkDotNet.Artifacts

# Python bytecode (the scripts under benchmarks/ and .github/scripts/)
__pycache__/

# Local AI agent state (tracked: the development skills in .claude/skills, which .agents/skills links to, and the
# project's hooks and settings; settings.local.json and worktrees stay local)
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.roo/
.roomodes
/memory/
.cursor/
.aider/
.copilot/
.mcp.json
claude-flow.config.json
.swarm/
.hive-mind/
.claude-flow/
coordination/memory_bank/*
coordination/subtasks/*
coordination/orchestration/*
claude-flow
claude-flow.bat
claude-flow.ps1
hive-mind-prompt-*.txt
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-wal

# TypeScript benchmark output
runtimes/typescript/bench/out/
runtimes/typescript/bench/gen/

# The TypeScript runtime's dev dependencies
runtimes/typescript/node_modules/
runtimes/typescript/dist/
runtimes/typescript/bench/node_modules/
# skill-creator writes each skill's eval runs next to it (<skill>-workspace/): results, not sources.
skills/*-workspace/
.claude/skills/*-workspace/
