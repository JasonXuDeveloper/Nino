<Project Sdk="Microsoft.NET.Sdk">

    <!-- Starts Nino.Fuzz once its assemblies are instrumented (run.sh). Instrumented code writes its coverage through
         SharpFuzz.Common.Trace.SharedMem, which is null until SharpFuzz connects to the driver; Nino.Fuzz's module
         initializer (the generated registry) runs instrumented code before its Main. This program, which references
         no Nino assembly, points SharedMem at a scratch buffer first, then loads Nino.Fuzz. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SharpFuzz"/>
    </ItemGroup>

</Project>
