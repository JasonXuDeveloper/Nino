<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <!-- Annotations only: the generator is tested on nullable types, but the test fixtures leave members unset
             and pass null on purpose, so the flow-analysis warnings would be noise. -->
        <Nullable>annotations</Nullable>
        <!-- C# 11, not latest: the oldest version the test types compile with (required members), and the one from
             which the generator makes its interceptors file-local. Generated code must not need anything newer
             (Unity and older SDKs compile it at lower versions), and this build would catch it. -->
        <LangVersion>11</LangVersion>
        <OutputType>Library</OutputType>
        <TargetFrameworks>net8.0;net10.0;netstandard2.1</TargetFrameworks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <ReportAnalyzer>true</ReportAnalyzer>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <NoWarn>$(NoWarn);RS1022;NU1608</NoWarn>
        <!-- The Roslyn test libraries bring in packages with security advisories: the patched versions in
             Directory.Packages.props replace them. -->
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- netstandard2.1 is only compiled, never run: it checks the generated code builds the way Unity builds it. It
         gets no test runner packages, dotnet test skips it, and the assembly version conflicts a netstandard2.1
         library cannot redirect (System.Memory and System.ValueTuple from packages vs. the facades) only matter at
         run time. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.1' ">
        <IsTestProject>false</IsTestProject>
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <!-- WEAK_VERSION_TOLERANCE: the generator makes the types of this assembly version tolerant (those of
         Nino.UnitTests.Subset, built without it, are not). Appended: the configuration's DEBUG stays. -->
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);WEAK_VERSION_TOLERANCE</DefineConstants>
    </PropertyGroup>

    <!-- The netstandard builds of Nino.Core have no PriorityQueue formatter (netstandard has no PriorityQueue). -->
    <PropertyGroup Condition="'$(NinoCoreTfm)' != ''">
      <DefineConstants>$(DefineConstants);NINO_CORE_NETSTANDARD</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.MSTest" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.MSTest" />
        <PackageReference Include="PolySharp">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="MSTest.TestFramework" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' != 'netstandard2.1' ">
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="coverlet.collector">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>


    <ItemGroup>
        <!-- Build with -p:NinoCoreTfm=netstandard2.0 (or netstandard2.1) to test a specific Nino.Core build. -->
        <ProjectReference Include="..\..\src\Nino.Core\Nino.Core.csproj" Condition="'$(NinoCoreTfm)' == ''"/>
        <ProjectReference Include="..\..\src\Nino.Core\Nino.Core.csproj" Condition="'$(NinoCoreTfm)' != ''"
                          SetTargetFramework="TargetFramework=$(NinoCoreTfm)"/>
        <ProjectReference Include="..\..\src\Nino.Immutable\Nino.Immutable.csproj"/>
        <!-- Unity's formatters, against the stand-in for UnityEngine.CoreModule they are compiled with. -->
        <ProjectReference Include="..\..\src\Nino.UnityTypes\Nino.UnityTypes.csproj"/>
        <ProjectReference Include="..\..\src\Nino.UnityTypes\UnityEngineStub\UnityEngine.CoreModule.csproj"/>
        <!-- The Roslyn 4.3 build is referenced by the generator tests; the code under test is generated by the
             Roslyn 4.12 build, as on current SDKs. Build with -p:NinoRegularCalls=true to test the calls without
             interceptors (as on Unity and older compilers), or with -p:NinoGeneratorBuild=4.8 to generate it with the Roslyn 4.8 build (.NET 8 SDK
             interceptors, which current compilers still accept). -->
        <ProjectReference Include="..\..\src\Nino.Generator\Nino.Generator.csproj" ReferenceOutputAssembly="true"/>
        <ProjectReference Include="..\..\src\Nino.Generator.Roslyn4.12\Nino.Generator.Roslyn4.12.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                          Condition="'$(NinoGeneratorBuild)' != '4.8'"/>
        <ProjectReference Include="..\..\src\Nino.Generator.Roslyn4.8\Nino.Generator.Roslyn4.8.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                          Condition="'$(NinoGeneratorBuild)' == '4.8'"/>
        <ProjectReference Include="..\..\src\Nino.Generator.CodeFixes\Nino.Generator.CodeFixes.csproj" />
        <ProjectReference Include="..\Nino.UnitTests.Subset\Nino.UnitTests.Subset.csproj" />
    </ItemGroup>

    <Import Project="..\..\src\Nino.Generator\build\Nino.Generator.props"/>
    <PropertyGroup Condition="'$(NinoRegularCalls)' == 'true'">
        <InterceptorsNamespaces></InterceptorsNamespaces>
        <InterceptorsPreviewNamespaces></InterceptorsPreviewNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <!-- The code generator's templates, to check that their checked-in output is current. -->
        <Compile Include="..\..\tools\CodeGen\TupleFormattersTemplate.cs" Link="CodeGen\TupleFormattersTemplate.cs"/>
        <Compile Include="..\..\tools\CodeGen\MultiDimFormattersTemplate.cs" Link="CodeGen\MultiDimFormattersTemplate.cs"/>
    </ItemGroup>

</Project>
