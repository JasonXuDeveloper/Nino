<Project Sdk="Microsoft.NET.Sdk">

    <!-- Nino.Codegen in builds: TypeScriptTests runs the TypeScript generated for Samples.cs under Node against the bytes
         .NET writes; BuildTests builds scratch projects with build/Nino.Codegen.targets, for every language. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="MSTest.TestAdapter"/>
        <PackageReference Include="MSTest.TestFramework"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Nino.Core\Nino.Core.csproj"/>
        <ProjectReference Include="..\..\src\Nino.Codegen\Nino.Codegen.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="harness.ts" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- What the scratch projects of BuildTests build with: nino-gen and the generator, as built here (their target
         paths, from MSBuild's GetTargetPath). -->
    <Target Name="NinoToolPaths" BeforeTargets="GetAssemblyAttributes">
        <MSBuild Projects="..\..\src\Nino.Codegen\Nino.Codegen.csproj" Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" PropertyName="_NinoCodegenTool"/>
        </MSBuild>
        <MSBuild Projects="..\..\src\Nino.Generator.Roslyn4.12\Nino.Generator.Roslyn4.12.csproj" Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" PropertyName="_NinoGenerator"/>
        </MSBuild>
        <ItemGroup>
            <AssemblyMetadata Include="NinoCodegenTool" Value="$(_NinoCodegenTool)"/>
            <AssemblyMetadata Include="NinoGenerator" Value="$(_NinoGenerator)"/>
        </ItemGroup>
    </Target>

    <Import Project="..\..\build\UseNinoGenerator.props"/>
    <Import Project="..\Shared\RepositoryFiles.props"/>
</Project>
