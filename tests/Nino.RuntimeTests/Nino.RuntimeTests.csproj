<Project Sdk="Microsoft.NET.Sdk">

    <!-- The same bytes on every runtime: run on .NET (net10.0) and on Mono (net472, the netstandard2.0 build of
         Nino.Core, with the class libraries of .NET Framework and Mono, whose collections have other fields than
         .NET's), it prints a hash of what each case writes; CI compares the outputs of each runtime (.NET on x64, Arm64
         and Arm32, Mono on x64 and Arm64, .NET Framework 64-bit and 32-bit on Windows; see .github/workflows/ci.yml). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net472</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <!-- -p:NinoX86=true: a 32-bit process (.NET Framework x86 in CI's Windows job), built beside the AnyCPU one.
         Only this project: an x86 analyzer (the generator) would not load into the 64-bit compiler. -->
    <PropertyGroup Condition="'$(NinoX86)' == 'true'">
        <PlatformTarget>x86</PlatformTarget>
        <OutputPath>bin\x86\$(Configuration)\</OutputPath>
        <IntermediateOutputPath>obj\x86\$(Configuration)\</IntermediateOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all"/>
        <ProjectReference Include="..\..\src\Nino.Core\Nino.Core.csproj" Condition="'$(TargetFramework)' != 'net472'"/>
        <ProjectReference Include="..\..\src\Nino.Core\Nino.Core.csproj" Condition="'$(TargetFramework)' == 'net472'"
                          SetTargetFramework="TargetFramework=netstandard2.0"/>
        <ProjectReference Include="..\..\src\Nino.Immutable\Nino.Immutable.csproj" Condition="'$(TargetFramework)' == 'net472'"
                          SetTargetFramework="TargetFramework=netstandard2.0"/>
        <ProjectReference Include="..\..\src\Nino.Immutable\Nino.Immutable.csproj" Condition="'$(TargetFramework)' != 'net472'"/>
        <ProjectReference Include="..\..\src\Nino.Generator.Roslyn4.12\Nino.Generator.Roslyn4.12.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <Import Project="..\..\src\Nino.Generator\build\Nino.Generator.props"/>
</Project>
