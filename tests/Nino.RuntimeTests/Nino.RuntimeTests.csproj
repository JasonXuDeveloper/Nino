<Project Sdk="Microsoft.NET.Sdk">

    <!-- The same bytes on every runtime: run on .NET (net10.0) and on Mono (net472, the netstandard2.1 builds of
         Nino.Core and Nino.Immutable, with Mono's class libraries, whose collections have other fields than .NET's), it
         prints a hash of what each case writes; CI compares the outputs of each runtime (.NET on x64, Arm64, Arm32 and
         Windows x86, Mono on x64 and Arm64; see .github/workflows/ci.yml). The net472 build is made only where Mono's
         class libraries are installed (MonoLibraries, below). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <MonoLibraries Condition="'$(MonoLibraries)' == ''">/usr/lib/mono/4.5/</MonoLibraries>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <TargetFrameworks Condition="Exists('$(MonoLibraries)mscorlib.dll')">net10.0;net472</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Nino.Core\Nino.Core.csproj" Condition="'$(TargetFramework)' != 'net472'"/>
        <ProjectReference Include="..\..\src\Nino.Immutable\Nino.Immutable.csproj" Condition="'$(TargetFramework)' != 'net472'"/>
    </ItemGroup>

    <!-- net472 is Mono's (Mono implements netstandard2.1; .NET Framework does not). It compiles against Mono's own
         class libraries (FrameworkPathOverride: its 4.5 profile, whose netstandard facade is 2.1) and the netstandard2.1
         builds of Nino.Core and Nino.Immutable. NuGet refuses a net472 project referencing netstandard2.1 projects, so
         their outputs are referenced by path (the ProjectReference only builds them). System.Collections.Immutable's
         dependencies bring their own Span, ArrayPool and Vector, which Mono's class library has too: they are referenced
         under an alias, so this code sees the class library's (as Nino.Core does), the way Unity runs Nino.Core's
         netstandard2.1 build beside them. -p:MonoLibraries names another Mono's 4.5 folder (macOS:
         /Library/Frameworks/Mono.framework/Versions/Current/lib/mono/4.5/). -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
        <FrameworkPathOverride>$(MonoLibraries)</FrameworkPathOverride>
        <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <ProjectReference Include="..\..\src\Nino.Immutable\Nino.Immutable.csproj" SetTargetFramework="TargetFramework=netstandard2.1"
                          SkipGetTargetFrameworkProperties="true" ReferenceOutputAssembly="false"/>
        <Reference Include="$(MonoLibraries)Facades/netstandard.dll"/>
        <Reference Include="..\..\src\Nino.Core\bin\$(Configuration)\netstandard2.1\Nino.Core.dll"/>
        <Reference Include="..\..\src\Nino.Immutable\bin\$(Configuration)\netstandard2.1\Nino.Immutable.dll"/>
        <PackageReference Include="System.Collections.Immutable"/>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe"/>
        <PackageReference Include="System.Memory" Aliases="PackageMemory"/>
        <PackageReference Include="System.Buffers" Aliases="PackageMemory"/>
        <PackageReference Include="System.Numerics.Vectors" Aliases="PackageMemory"/>
    </ItemGroup>

    <!-- CoreCLR x64's bytes for BclStructs and the types they are of, shared with Unity's BclLayoutTests: they live in
         the Unity project, which compiles only files under its Assets folder. -->
    <ItemGroup>
        <Compile Include="..\..\src\Nino.Unity\Assets\Test\Runtime\BclFixtures.cs" Link="BclFixtures.cs"/>
        <Compile Include="..\..\src\Nino.Unity\Assets\Test\Runtime\BclFixtureTypes.cs" Link="BclFixtureTypes.cs"/>
    </ItemGroup>

    <Import Project="..\..\tools\UseNinoGenerator.props"/>
</Project>
