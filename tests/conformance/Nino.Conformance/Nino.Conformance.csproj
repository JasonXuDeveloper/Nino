<Project Sdk="Microsoft.NET.Sdk">

    <!-- Writes the shared conformance corpus (tests/conformance/corpus) that every Nino runtime (.NET, TypeScript, Go,
         Rust) is tested against, and checks it: see tests/conformance/README.md. Not part of src/Nino.sln. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- With a .NET 11 SDK, net11.0 and C# 15: the corpus's C# unions (Types.cs) need it. The committed corpus and
             the generated files under runtimes/ are written with it; CI's integrations job installs that SDK. -->
        <TargetFramework Condition=" $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0')) ">net11.0</TargetFramework>
        <LangVersion Condition=" $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0')) ">preview</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
        <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
        <NoWarn>$(NoWarn);CS0649</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Nino.Core\Nino.Core.csproj"/>
    </ItemGroup>

    <Import Project="..\..\..\tools\UseNinoGenerator.props"/>
</Project>
