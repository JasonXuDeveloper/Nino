<Project Sdk="Microsoft.NET.Sdk">
    <!-- The generator seam prototype (#355): user-type elements through the string run kernels against the generated
         per-element body. A focused harness (bench), a byte-identity check (verify). Not published. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <TieredPGO>true</TieredPGO>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Nino.Core\Nino.Core.csproj"/>
    </ItemGroup>
    <Import Project="..\..\tools\UseNinoGenerator.props"/>
</Project>
