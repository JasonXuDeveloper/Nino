<Project Sdk="Microsoft.NET.Sdk">
    <!-- Declares the benchmark's types and writes their data (see run.sh). Outside runtimes/csharp, so it does not inherit
         its Directory.Build.props: the properties it needs are set here. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\csharp\src\Nino.Core\Nino.Core.csproj"/>
        <ProjectReference Include="..\..\csharp\src\Nino.Generator.Roslyn4.12\Nino.Generator.Roslyn4.12.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>
    <Import Project="..\..\csharp\src\Nino.Generator\build\Nino.Generator.props"/>
</Project>
