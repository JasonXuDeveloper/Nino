{
  "name": "nino-serialization",
  "version": "4.0.0-rc.7",
  "description": "The TypeScript runtime of Nino: reads and writes the bytes Nino v4 writes in .NET, for the classes and codecs nino-gen (Nino.Codegen) generates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonXuDeveloper/Nino.git",
    "directory": "runtimes/typescript"
  },
  "homepage": "https://nino.xgamedev.net/en/docs/v4/advanced/codegen",
  "keywords": [
    "nino",
    "serialization",
    "binary",
    "serializer",
    "dotnet",
    "codegen"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/nino.d.ts",
      "default": "./dist/nino.js"
    }
  },
  "types": "./dist/nino.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:wasm": "node wasm/build.ts",
    "typecheck": "tsc -p .",
    "test": "tsc -p . && npm run test:node && npm run test:browser && npm run test:no-wasm",
    "test:node": "node --test \"test/**/*.test.ts\"",
    "test:browser": "NINO_TEST_RUNTIME=browser node --import ./test/runtime.ts --test \"test/**/*.test.ts\"",
    "test:no-wasm": "NINO_TEST_RUNTIME=browser NINO_WASM=0 node --import ./test/runtime.ts --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
