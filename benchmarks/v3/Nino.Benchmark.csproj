<Project Sdk="Microsoft.NET.Sdk">

    <!-- Mirrors benchmarks/Nino.Benchmark/Nino.Benchmark.csproj, but takes Nino from nuget.org (3.3.13). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Optimize>true</Optimize>
        <!-- Same assembly/project name as v4 so BDN artifacts and report file names line up. -->
        <AssemblyName>Nino.Benchmark</AssemblyName>
        <RootNamespace>Nino.Benchmark</RootNamespace>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <!-- Its own package versions: v3 from nuget.org, not the repository's central ones (Directory.Packages.props). -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Nino" Version="3.3.13" />
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="MemoryPack" Version="1.21.4" />
        <PackageReference Include="MessagePack" Version="3.1.12" />
        <PackageReference Include="MessagePackAnalyzer" Version="3.1.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- v4's job and data, compiled from its files: the two runs differ only in the library they call. -->
        <Compile Include="..\Nino.Benchmark\NinoJobAttribute.cs" Link="NinoJobAttribute.cs"/>
        <Compile Include="..\Nino.Benchmark\SimpleBenchmarkData.cs" Link="SimpleBenchmarkData.cs"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="BenchmarkDotNet.Attributes"/>
    </ItemGroup>
</Project>
