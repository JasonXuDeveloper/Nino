<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Optimize>true</Optimize>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- -p:NinoBenchLegacy=true leaves out the benchmarks an older release's generator cannot compile (A/B runs). -->
        <DefineConstants Condition="'$(NinoBenchLegacy)' == 'true'">$(DefineConstants);NINO_BENCH_LEGACY</DefineConstants>
        <!-- The v3 build (NINO_BENCH_V3=true): Program.cs without the proto writer, the shared models without their v4-only
             attributes. -->
        <DefineConstants Condition="'$(NinoBenchV3)' == 'true'">$(DefineConstants);NINO_BENCH_V3</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
        <PackageReference Include="MemoryPack" />
        <PackageReference Include="MessagePack" />
        <PackageReference Include="MessagePack.ImmutableCollection" />
        <PackageReference Include="protobuf-net" />
        <PackageReference Include="Google.Protobuf" />
        <PackageReference Include="Grpc.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="MessagePackAnalyzer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="'$(NinoBenchV3)' != 'true'">
        <!-- Build with -p:NinoCoreTfm=netstandard2.0 (or netstandard2.1) to benchmark a specific Nino.Core build. -->
        <ProjectReference Include="..\..\src\Nino.Core\Nino.Core.csproj" Condition="'$(NinoCoreTfm)' == ''"/>
        <ProjectReference Include="..\..\src\Nino.Core\Nino.Core.csproj" Condition="'$(NinoCoreTfm)' != ''"
                          SetTargetFramework="TargetFramework=$(NinoCoreTfm)"/>
        <ProjectReference Include="..\..\src\Nino.Immutable\Nino.Immutable.csproj"/>
        <ProjectReference Include="..\..\src\Nino.Generator.Roslyn4.12\Nino.Generator.Roslyn4.12.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <Compile Remove="V3/**"/>
        <Protobuf Include="Workloads/workloads.proto" GrpcServices="None"/>
        <!-- SimpleTest's and PolymorphicTest's messages import protobuf-net's bcl.proto (DateTime, Guid) from Fixtures/. -->
        <Protobuf Include="Fixtures/cases.proto;Fixtures/protobuf-net/bcl.proto" ProtoRoot="Fixtures" GrpcServices="None"/>
        <!-- The classes check them against what the models' protobuf-net contracts generate (ProtoFile, Nino.Benchmark
             with write-proto). -->
        <EmbeddedResource Include="Workloads/workloads.proto" LogicalName="workloads.proto"/>
        <EmbeddedResource Include="Fixtures/cases.proto" LogicalName="cases.proto"/>
    </ItemGroup>

    <!-- The v3 run (NINO_BENCH_V3=true, Directory.Build.props): Nino 3.3.13 from nuget.org and the same SimpleTest,
         PolymorphicTest, NullableTest, CollectionsTest's nullable collections, WorkloadTest and PooledGraphTest's Leaves
         ported to its API (V3/), with this project's data, models, job, columns and checks; the two runs differ only in
         the library they call. One project for both, so BenchmarkDotNet finds one Nino.Benchmark.csproj. -->
    <ItemGroup Condition="'$(NinoBenchV3)' == 'true'">
        <PackageReference Include="Nino" VersionOverride="3.3.13"/>
        <Compile Remove="**/*.cs"/>
        <Compile Include="Program.cs;Harness/Verify.cs;Harness/PayloadColumn.cs;Harness/NinoJobAttribute.cs;Fixtures/SimpleBenchmarkData.cs;Fixtures/PolymorphicBenchmarkData.cs;Fixtures/NullableBenchmarkData.cs;Fixtures/PooledLeaf.cs;V3/SimpleTest.cs;V3/PolymorphicTest.cs;V3/NullableTest.cs;V3/CollectionsTest.cs;V3/PooledGraphTest.cs;V3/WorkloadTest.cs"/>
        <!-- The workloads' models, shared with v4 (their v4-only attributes behind #if NINO_BENCH_V3); the versioned
             ones and Common.cs from their own project, which turns on v3's version tolerance (see there). -->
        <Compile Include="Workloads/StandardModels.cs;Workloads/ServiceModels.cs;Workloads/GameModels.cs"/>
        <ProjectReference Include="V3/Versioned/Nino.Benchmark.V3Versioned.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="BenchmarkDotNet.Attributes"/>
    </ItemGroup>
    <Import Project="..\..\src\Nino.Generator\build\Nino.Generator.props" Condition="'$(NinoBenchV3)' != 'true'"/>
</Project>
