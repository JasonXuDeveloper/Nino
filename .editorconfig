root = true

[*.cs]
# Static members of generic types are Nino's per-type caches (NinoFormatterCache<T>, NinoPool<T>...): by design,
# a static field per closed type is the cheapest lookup there is.
dotnet_diagnostic.CA1000.severity = none
# ArgumentNullException.ThrowIfNull and friends do not exist on netstandard2.0/2.1, which share the source.
dotnet_diagnostic.CA1510.severity = none
dotnet_diagnostic.CA1512.severity = none

# Analyzer code (the generator and the code fixes) runs inside the compiler and the IDE: no culture-sensitive string
# operations.
[{Nino.Generator,Nino.Generator.CodeFixes}/**.cs]
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error

# These projects group files by responsibility. Moving a file between folders does not rename its type.
[{src/Nino.Core,src/Nino.Generator,tests/Nino.UnitTests,tests/Nino.UnitTests.Subset,tests/Nino.Codegen.Tests,tests/Nino.Codegen.Integration.Tests,benchmarks/Nino.Benchmark,tests/conformance/Nino.Conformance}/**.cs]
dotnet_style_namespace_match_folder = false
