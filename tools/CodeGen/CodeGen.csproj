<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Writes the template-generated sources of Nino.Core (see Program.cs for how to run it).
      Deliberately not part of src/Nino.slnx: nothing at build time depends on it, and Nino.UnitTests compiles the
      templates as source to check that the checked-in output is current.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>Nino.CodeGen</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
