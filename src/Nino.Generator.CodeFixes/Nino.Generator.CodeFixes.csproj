<Project Sdk="Microsoft.NET.Sdk">

    <!--
    Code fixes live in their own assembly: they need Microsoft.CodeAnalysis.Workspaces, which only IDEs load.
    The compiler (and Unity) load Nino.Generator alone, so they never resolve Workspaces types (RS1038).
    Shipped inside the Nino.Generator package.
    -->
    <Import Project="..\Nino.Generator\Roslyn.Build.props"/>

    <PropertyGroup>
        <!-- NINO_GENERATOR selects the namespace of the sources shared with Nino.Core (NinoHash), as in the generator. -->
        <DefineConstants>$(DefineConstants);NINO_GENERATOR</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- Shared with the analyzer: the diagnostics being fixed, the pool hooks NINO019 asks for, Nino.Core names. -->
        <Compile Include="..\Nino.Generator\Analysis\NinoDiagnostics.cs" Link="Shared\NinoDiagnostics.cs"/>
        <Compile Include="..\Nino.Generator\Common\NinoNames.cs" Link="Shared\NinoNames.cs"/>
        <Compile Include="..\Nino.Generator\Common\PoolHooks.cs" Link="Shared\PoolHooks.cs"/>
        <!-- The layout baseline: its format and rules (with nino-gen), and the names and ids of types (runtime form). -->
        <Compile Include="..\Nino.Generator\Common\LayoutBaseline.cs" Link="Shared\LayoutBaseline.cs"/>
        <Compile Include="..\Nino.Generator\Common\LayoutRules.cs" Link="Shared\LayoutRules.cs"/>
        <Compile Include="..\Nino.Generator\Generation\Binding\TypeNames.cs" Link="Shared\TypeNames.cs"/>
        <Compile Include="..\Nino.Generator\Common\TextScratch.cs" Link="Shared\TextScratch.cs"/>
        <Compile Include="..\Nino.Core\Internal\Metadata\NinoHash.cs" Link="Shared\NinoHash.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all"/>
        <PackageReference Include="System.Collections.Immutable" VersionOverride="6.0.1" />
    </ItemGroup>

</Project>
