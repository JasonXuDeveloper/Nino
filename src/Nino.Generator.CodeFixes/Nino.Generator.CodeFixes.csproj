<Project Sdk="Microsoft.NET.Sdk">

    <!--
    Code fixes live in their own assembly: they need Microsoft.CodeAnalysis.Workspaces, which only IDEs load.
    The compiler (and Unity) load Nino.Generator alone, so they never resolve Workspaces types (RS1038).
    Shipped inside the Nino.Generator package.
    -->
    <Import Project="..\Nino.Generator\Roslyn.Build.props"/>

    <ItemGroup>
        <!-- Shared with the analyzer: the diagnostics being fixed, the pool hooks NINO019 asks for, Nino.Core names. -->
        <Compile Include="..\Nino.Generator\Analysis\NinoDiagnostics.cs" Link="Shared\NinoDiagnostics.cs"/>
        <Compile Include="..\Nino.Generator\Common\NinoNames.cs" Link="Shared\NinoNames.cs"/>
        <Compile Include="..\Nino.Generator\Common\PoolHooks.cs" Link="Shared\PoolHooks.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all"/>
    </ItemGroup>

</Project>
