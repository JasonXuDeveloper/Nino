<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>11</LangVersion>
        <OutputType>Library</OutputType>
        <TargetFrameworks>net8.0;net10.0;netstandard2.1</TargetFrameworks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <ReportAnalyzer>true</ReportAnalyzer>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <NoWarn>RS1022;NU1608</NoWarn>
    </PropertyGroup>

    <!-- netstandard2.1 is only compiled, never run: it checks the generated code builds the way Unity builds it. The
         test packages support only runnable targets, so their target checks are off for it. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.1' ">
        <SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DefineConstants>TRACE;WEAK_VERSION_TOLERANCE</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DefineConstants>TRACE;WEAK_VERSION_TOLERANCE</DefineConstants>
    </PropertyGroup>

    <!-- The netstandard builds of Nino.Core have no PriorityQueue formatter (netstandard has no PriorityQueue). -->
    <PropertyGroup Condition="'$(NinoCoreTfm)' != ''">
      <DefineConstants>$(DefineConstants);NINO_CORE_NETSTANDARD</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.MSTest" Version="1.1.2" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.MSTest" Version="1.1.2" />
        <PackageReference Include="PolySharp" Version="1.16.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Buffers" Version="4.6.1" />
        <PackageReference Include="System.Memory" Version="4.6.3" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
        <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
        <PackageReference Include="coverlet.collector" Version="10.1.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Patched versions of packages the Roslyn test libraries bring in (security advisories). -->
    <ItemGroup>
      <PackageReference Include="System.Net.Http" Version="4.3.4" />
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
      <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
        <!-- Build with -p:NinoCoreTfm=netstandard2.0 (or netstandard2.1) to test a specific Nino.Core build. -->
        <ProjectReference Include="..\Nino.Core\Nino.Core.csproj" Condition="'$(NinoCoreTfm)' == ''"/>
        <ProjectReference Include="..\Nino.Core\Nino.Core.csproj" Condition="'$(NinoCoreTfm)' != ''"
                          SetTargetFramework="TargetFramework=$(NinoCoreTfm)"/>
        <ProjectReference Include="..\Nino.Immutable\Nino.Immutable.csproj"/>
        <!-- The Roslyn 4.3 build is referenced by the generator tests; the code under test is generated by the
             Roslyn 4.12 build, as on current SDKs. Build with -p:NinoRegularCalls=true to test the calls without
             interceptors (as on Unity and older compilers), or with -p:NinoGeneratorBuild=4.8 to generate it with the Roslyn 4.8 build (.NET 8 SDK
             interceptors, which current compilers still accept). -->
        <ProjectReference Include="..\Nino.Generator\Nino.Generator.csproj" ReferenceOutputAssembly="true"/>
        <ProjectReference Include="..\Nino.Generator.Roslyn4.12\Nino.Generator.Roslyn4.12.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                          Condition="'$(NinoGeneratorBuild)' != '4.8'"/>
        <ProjectReference Include="..\Nino.Generator.Roslyn4.8\Nino.Generator.Roslyn4.8.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                          Condition="'$(NinoGeneratorBuild)' == '4.8'"/>
        <ProjectReference Include="..\Nino.Generator.CodeFixes\Nino.Generator.CodeFixes.csproj" />
        <ProjectReference Include="..\Nino.UnitTests.Subset\Nino.UnitTests.Subset.csproj" />
    </ItemGroup>

    <Import Project="..\Nino.Generator\build\Nino.Generator.props"/>
    <PropertyGroup Condition="'$(NinoRegularCalls)' == 'true'">
        <InterceptorsNamespaces></InterceptorsNamespaces>
        <InterceptorsPreviewNamespaces></InterceptorsPreviewNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <!-- The code generator's templates, to check that their checked-in output is current. -->
        <Compile Include="..\..\tools\CodeGen\TupleFormattersTemplate.cs" Link="CodeGen\TupleFormattersTemplate.cs"/>
    </ItemGroup>

</Project>
