<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>nino-gen</AssemblyName>
        <RootNamespace>Nino.Codegen</RootNamespace>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <!-- Enum members named after the values they stand for (String, Object, Decimal...), types named XEnum. -->
        <NoWarn>$(NoWarn);CA1720;CA1711</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nino.TypeScript"/>
        <InternalsVisibleTo Include="Nino.TypeScript.Tests"/>
        <InternalsVisibleTo Include="Nino.Codegen.Tests"/>
        <!-- The templates, by their path under Templates/ (typescript/types.sbn). -->
        <EmbeddedResource Include="Templates\**\*.sbn" LogicalName="templates/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="..\..\runtimes\typescript\src\nino.ts" LogicalName="nino.ts" Link="Runtime\nino.ts"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Scriban"/>
        <PackageReference Include="System.Reflection.MetadataLoadContext"/>
    </ItemGroup>

</Project>
