<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Run with whatever .NET runtime is installed, 8.0 or later. -->
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>LatestMajor</RollForward>
        <AssemblyName>nino-gen</AssemblyName>
        <RootNamespace>Nino.Codegen</RootNamespace>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <!-- Enum members named after the values they stand for (String, Object, Decimal...), types named XEnum. -->
        <NoWarn>$(NoWarn);CA1720;CA1711</NoWarn>
        <PackageId>Nino.Codegen</PackageId>
        <Description>nino-gen: writes TypeScript, Go and Rust types and codecs that read and write the bytes a .NET assembly's [NinoType]s are serialized to, from the layouts the Nino generator published in the built assembly.</Description>
        <PackageTags>Nino;Serialization;Binary;TypeScript;Go;Rust;CodeGeneration</PackageTags>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>nino-gen</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nino.TypeScript"/>
        <InternalsVisibleTo Include="Nino.TypeScript.Tests"/>
        <InternalsVisibleTo Include="Nino.Codegen.Tests"/>
        <!-- The templates, by their path under Templates/ (typescript/types.sbn). -->
        <EmbeddedResource Include="Templates\**\*.sbn" LogicalName="templates/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="..\..\runtimes\typescript\src\nino.ts" LogicalName="nino.ts" Link="Runtime\nino.ts"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Scriban"/>
        <PackageReference Include="System.Reflection.MetadataLoadContext"/>
    </ItemGroup>

</Project>
