    $o = $o + "\treturn new" + c.name + "Codec(" + (array.join $pnames ", ") + ").self\n}\n\n"
    $o = $o + "func new" + c.name + "Codec" + c.type_params + "(" + (array.join $params ", ") + ") *" + $codec + c.type_args + " {\n"
  else
    $o = $o + "func " + c.name + "Codec" + c.type_params + "(" + (array.join $params ", ") + ") NinoArg[" + $value + "] {\n"
  end
  $fields = []
  for $p in $pnames
