{{~
# The Go of an assembly's [NinoType]s (GoTarget): enums, raw structs, structs with their tags and layouts, class
# descriptors, bodies, polymorphic slots, then the functions values of one shape share. gofmt leaves it as it is.
include "shapes.sbn"

# A struct declaration: its fields with their nino tag (position or key, utf8) and the extra tags.
func struct_decl(name, fields, keyed)
  if fields.size == 0
    ret "type " + name + " struct{}\n"
  end
  $names = []
  $types = []
  $tags = []
  $position = 0
  for $f in fields
    $names = array.add $names $f.name
    $types = array.add $types (gotype($f.shape))
    if $f.csharp == "$elements"
      # A [NinoType] collection's elements: no member of the struct tags (they reject the type's layout).
      $tag = "nino:\"-\""
    else
      $tag = keyed ? $f.csharp : ("" + $position)
      $position = $position + 1
      if $f.shape.kind == "utf8" || $f.shape.kind == "keyutf8"
        $tag = $tag + ",utf8"
      end
      $tag = "nino:\"" + $tag + "\""
    end
    for $t in extra_tags
      $tag = $tag + " " + $t + ":\"" + tag_name($f.csharp) + "\""
    end
    $tags = array.add $tags ("`" + $tag + "`")
  end
  $nw = 0
  $tw = 0
  for $i in 0..($names.size - 1)
    if $names[$i].size > $nw
      $nw = $names[$i].size
    end
    if $types[$i].size > $tw
      $tw = $types[$i].size
    end
  end
  $o = "type " + name + " struct {\n"
  for $i in 0..($names.size - 1)
    $o = $o + "\t" + pad($names[$i], $nw) + " " + pad($types[$i], $tw) + " " + $tags[$i] + "\n"
  end
  ret $o + "}\n"
end

# The statements reading the members into `v` (a *T for a class body, a T for a struct).
func read_members(c)
  $o = ""
  # A [NinoType] collection's elements: before the members (positional), before the region (version tolerant), or
  # first in it (keyed). Null elements are invalid (the collection is the object itself).
  $e = c.elements_member
  $elements = $e ? "\tv." + $e.name + " = ninoElements(r, " + read($e.shape) + ")\n" : ""
  if c.format == "keyed"
    # Members by key, in any order, each at most once; a key this version does not know is skipped.
    $o = $o + "\tg := r.BeginRegion()\n" + $elements
    if c.seen_words == 1
      $o = $o + "\tvar seen uint64\n"
    else if c.seen_words > 1
      $o = $o + "\tvar seen [" + c.seen_words + "]uint64\n"
    end
    $o = $o + "\tfor r.More() {\n\t\tkey := r.I32()\n\t\te := r.BeginMember()\n\t\tswitch key {\n"
    for $m in c.members
      $keys = []
      for $k in $m.model.all_keys
        $keys = array.add $keys ("" + $k)
      end
      $seen = c.seen_words == 1 ? "&seen, " + for.index : "&seen[" + (for.index // 64) + "], " + (for.index % 64)
      $o = $o + "\t\tcase " + (array.join $keys ", ") + ":\n\t\t\tif r.KeyedSeen(" + $seen + ") {\n\t\t\t\t" + read_into($m.shape, "v." + $m.name) + "\n\t\t\t}\n"
    end
    $o = $o + "\t\tdefault:\n\t\t\tr.SkipMember(e)\n\t\t\tcontinue\n\t\t}\n\t\tr.EndMember(e)\n\t}\n\tr.EndRegion(g)\n"
  else if c.format == "tolerant"
    # Members written by an older version end early; those of a newer one are skipped.
    $o = $o + $elements + "\tg := r.BeginRegion()\n"
    for $m in c.members
      $o = $o + "\tif r.More() {\n\t\t" + read_into($m.shape, "v." + $m.name) + "\n\t}\n"
    end
    $o = $o + "\tr.EndRegion(g)\n"
  else
    $o = $o + $elements
    # Each run of fixed-size members takes its bytes with one bounds check.
    for $run in c.runs
      if $run.items.size == 1
        $o = $o + "\t" + read_into($run.items[0].member.shape, "v." + $run.items[0].member.name) + "\n"
      else
        $o = $o + "\tif b := r.Take(" + $run.size + "); len(b) == " + $run.size + " {\n"
        for $item in $run.items
          $o = $o + "\t\tv." + $item.member.name + " = " + decode($item.member.shape, $item.offset) + "\n"
        end
        $o = $o + "\t}\n"
      end
    end
  end
  ret $o
end

func write_members(c)
  $o = ""
  $e = c.elements_member
  # Nil elements are an empty collection: the collection is the object itself, never null.
  $elements = $e ? "\t" + write($e.shape, "ninoNonNil(v." + $e.name + ")") + "\n" : ""
  if c.format == "keyed"
    $o = $o + "\tg := w.BeginRegion()\n" + $elements
    for $m in c.members
      $o = $o + "\t" + (for.first ? "e := " : "e = ") + "w.BeginMember(" + $m.model.key + ")\n\t" + write($m.shape, "v." + $m.name) + "\n\tw.EndMember(e)\n"
    end
    $o = $o + "\tw.EndRegion(g)\n"
  else if c.format == "tolerant"
    $o = $o + $elements + "\tg := w.BeginRegion()\n"
    for $m in c.members
      $o = $o + "\t" + write($m.shape, "v." + $m.name) + "\n"
    end
    $o = $o + "\tw.EndRegion(g)\n"
  else
    $o = $o + $elements
    for $run in c.runs
      if $run.items.size == 1
        $o = $o + "\t" + write($run.items[0].member.shape, "v." + $run.items[0].member.name) + "\n"
      else
        $o = $o + "\tif b := w.Extend(" + $run.size + "); len(b) == " + $run.size + " {\n"
        for $item in $run.items
          $o = $o + lines(encode($item.member.shape, $item.offset, "v." + $item.member.name), "\t\t")
        end
        $o = $o + "\t}\n"
      end
    end
  end
  ret $o
end

func helper_body(h)
  $s = h.shape
  $n = h.name
  $t = gotype($s)
  if h.mode == "decode"
    $o = "func " + $n + "(r *nino.Reader, b []byte) " + $t + " {\n\t_ = b[" + ($s.size - 1) + "]\n"
    if $s.kind == "rawnullable"
      ret $o + "\tif !r.BoolAt(b[" + $s.flag_offset + "]) {\n\t\treturn nil\n\t}\n\tx := " + decode($s.inner, $s.value_offset) + "\n\treturn &x\n}\n"
    end
    $o = $o + "\tvar v " + $t + "\n"
    for $i in $s.items
      $o = $o + "\tv." + item($s, for.index) + " = " + decode($i, $s.offsets[for.index]) + "\n"
    end
    ret $o + "\treturn v\n}\n"
  else if h.mode == "encode"
    $o = "func " + $n + "(b []byte, v " + $t + ") {\n\t_ = b[" + ($s.size - 1) + "]\n"
    if $s.kind == "rawnullable"
      ret $o + "\tif v != nil {\n\t\tb[" + $s.flag_offset + "] = 1\n\t\tx := *v\n" + lines(encode($s.inner, $s.value_offset, "x"), "\t\t") + "\t}\n}\n"
    end
    for $i in $s.items
      $o = $o + lines(encode($i, $s.offsets[for.index], "v." + item($s, for.index)), "\t")
    end
    ret $o + "}\n"
  else if h.mode == "readinto"
    # Into *p: its storage reused when large enough, each element read into the one at its index (a map's entries
    # read new: a value is never reused for another key).
    $o = "func " + $n + "(r *nino.Reader, p *" + $t + ") {\n"
    if $s.kind == "map"
      $e = "nino.Entry[" + gotype($s.key) + ", " + gotype($s.value) + "]"
      ret $o + read_into_loop($e, plus($s.key, $s.value), "k := " + read($s.key) + "\n\t\te = " + $e + "{Key: k, Value: " + read($s.value) + "}", false) + "}\n"
    end
    $each = read_into($s.element, "e")
    ret $o + read_into_loop(gotype($s.element), $s.element.min, $each, $each != "e = " + read($s.element)) + "}\n"
  else if h.mode == "read" && reads_into($s)
    # The loop of the into form (a nil slice: a new one).
    ret "func " + $n + "(r *nino.Reader) (v " + $t + ") {\n\t" + helper($s, "readinto") + "(r, &v)\n\treturn v\n}\n"
  else if h.mode == "read"
    $o = "func " + $n + "(r *nino.Reader) " + $t + " {\n"
    case $s.kind
    when "enum"
      ret $o + "\treturn " + name($s.enum) + "(r." + $s.inner.primitive + "())\n}\n"
    when "rawnullable", "rawtuple"
      ret $o + "\tvar v " + $t + "\n\tif b := r.Take(" + $s.size + "); len(b) == " + $s.size + " {\n\t\tv = " + decode_fn($s) + "(r, b)\n\t}\n\treturn v\n}\n"
    when "nullable"
      ret $o + "\tif !r.Present() {\n\t\treturn nil\n\t}\n\tx := " + read($s.inner) + "\n\treturn &x\n}\n"
    when "tuple"
      $o = $o + "\tvar v " + $t + "\n"
      for $i in $s.items
        $o = $o + "\tv." + item($s, for.index) + " = " + read($i) + "\n"
      end
      ret $o + "\treturn v\n}\n"
    when "grid"
      $o = $o + "\tg := readGrid[" + gotype($s.element) + "](r, " + $s.rank + ", " + compact($s.element.min) + ")\n\tif g == nil {\n\t\treturn nil\n\t}\n"
      ret $o + "\tfor i := range g.Items {\n\t\tg.Items[i] = " + read($s.element) + "\n\t\tif r.Failed() {\n\t\t\treturn nil\n\t\t}\n\t}\n\treturn g\n}\n"
    when "map"
      $e = "nino.Entry[" + gotype($s.key) + ", " + gotype($s.value) + "]"
      $o = $o + read_loop($e, plus($s.key, $s.value), "k := " + read($s.key) + "\n\t\te = " + $e + "{Key: k, Value: " + read($s.value) + "}")
      # Keys read twice fail, checked once over the pairs.
      ret $o + ($s.mode == "unique" ? "\treturn nino.CheckUniqueKeys(r, v)\n}\n" : "\treturn v\n}\n")
    end
    # A sequence.
    case $s.mode
    when "unique"
      # Elements read twice fail, checked once over the elements (primitives read as one block).
      if $s.element.block
        ret $o + "\treturn nino.CheckUniqueValues(r, nino.ReadPrimitives[" + gotype($s.element) + "](r))\n}\n"
      end
      ret $o + read_loop(gotype($s.element), $s.element.min, "e = " + read($s.element)) + "\treturn nino.CheckUniqueValues(r, v)\n}\n"
    when "stringset"
      # A set of strings in the order of the data: a string (or null) read twice fails.
      ret $o + read_loop(gotype($s.element), $s.element.min, "e = " + read($s.element)) + "\treturn nino.CheckUniqueStrings(r, v)\n}\n"
    when "fixed"
      $b = $s.element.raw_block
      if $b
        ret $o + "\treturn nino.ReadRaw(r, " + $s.element.size + ", " + $b.as_is + ", " + $b.bools + ", " + decode_fn($s.element) + ")\n}\n"
      end
      # The elements' bytes with one bounds check, then each element's from a cursor.
      $z = $s.element.size
      $o = $o + "\tn := r.Length(" + $z + ")\n\tif n < 0 {\n\t\treturn nil\n\t}\n\tb := r.Take(n * " + $z + ")\n\tif len(b) != n*" + $z + " {\n\t\treturn nil\n\t}\n"
      $o = $o + make_slice(gotype($s.element)) + "\tfor len(b) >= " + $z + " {\n\t\te = " + decode_fn($s.element) + "(r, b[:" + $z + ":" + $z + "])\n"
      ret $o + "\t\tif r.Failed() {\n\t\t\treturn nil\n\t\t}\n\t\tv = append(v, e)\n\t\tb = b[" + $z + ":]\n\t}\n\treturn v\n}\n"
    end
    ret $o + read_loop(gotype($s.element), $s.element.min, "e = " + read($s.element)) + "\treturn v\n}\n"
  end

  $o = "func " + $n + "(w *nino.Writer, v " + $t + ") {\n"
  case $s.kind
  when "enum"
    ret $o + "\tw." + $s.inner.primitive + "(" + gotype($s.inner) + "(v))\n}\n"
  when "rawnullable", "rawtuple"
    ret $o + "\tif b := w.ExtendZero(" + $s.size + "); len(b) == " + $s.size + " {\n\t\t" + encode_fn($s) + "(b, v)\n\t}\n}\n"
  when "nullable"
    ret $o + "\tw.Present(v != nil)\n\tif v != nil {\n\t\t" + write($s.inner, "*v") + "\n\t}\n}\n"
  when "tuple"
    for $i in $s.items
      $o = $o + "\t" + write($i, "v." + item($s, for.index)) + "\n"
    end
    ret $o + "}\n"
  when "grid"
    ret $o + "\tif !writeGrid(w, v, " + $s.rank + ") {\n\t\treturn\n\t}\n\tfor _, e := range v.Items {\n\t\t" + write($s.element, "e") + "\n\t}\n}\n"
  when "map"
    ret $o + write_loop(write($s.key, "e.Key") + "\n\t\t" + write($s.value, "e.Value"))
  end
  if $s.mode == "fixed"
    $b = $s.element.raw_block
    if $b
      ret $o + "\tnino.WriteRaw(w, v, " + $s.element.size + ", " + $b.as_is + ", " + $b.bools + ", " + $b.pads + ", " + encode_fn($s.element) + ")\n}\n"
    end
    # One reservation, cleared (padding is written as zeros), then each element's bytes from a cursor.
    $z = $s.element.size
    $o = $o + "\tif v == nil {\n\t\tw.NullLength()\n\t\treturn\n\t}\n\tw.Length(len(v))\n\tb := w.ExtendZero(len(v) * " + $z + ")\n\tif len(b) != len(v)*" + $z + " {\n\t\treturn\n\t}\n"
    ret $o + "\tfor _, e := range v {\n\t\t" + encode_fn($s.element) + "(b[:" + $z + ":" + $z + "], e)\n\t\tb = b[" + $z + ":]\n\t}\n}\n"
  else if $s.element.block
    ret $o + "\tnino.WritePrimitives(w, v)\n}\n"
  else if $s.element.kind == "string" && !$s.element.field
    ret $o + "\tnino.WriteStringPtrs(w, v)\n}\n"
  else if $s.element.kind == "keystring" && !$s.element.field
    ret $o + "\tnino.WriteStrings(w, v)\n}\n"
  end
  ret $o + write_loop(write($s.element, "e"))
end

# The loop of a sequence's read helper: its length (n), then each element, read by `each` into `e` (of type `t`)
# with direct calls (no func value an element), appended to `v`. As the runtime's own loops do: nil for null and on a
# failure, the slice presized only as far as the bytes left allow (Reader.SliceCap).
func read_loop(t, min, each)
  $o = "\tn := r.Length(" + min + ")\n\tif n < 0 {\n\t\treturn nil\n\t}\n" + make_slice(t)
  ret $o + "\tfor range n {\n\t\t" + each + "\n\t\tif r.Failed() {\n\t\t\treturn nil\n\t\t}\n\t\tv = append(v, e)\n\t}\n"
end

# The loop of a sequence's readinto helper: as read_loop, into *p, whose storage is reused when it holds n elements
# (a nil one never: nil is null) and whose element i is what `each` reads into `e`. nil for null and on a failure.
func read_into_loop(t, min, each, reuse)
  $o = "\tn := r.Length(" + min + ")\n\tif n < 0 {\n\t\t*p = nil\n\t\treturn\n\t}\n\told := *p\n\tv := old[:0]\n"
  $o = $o + "\tif old == nil || cap(old) < n {\n\t\tvar z " + t + "\n\t\tv = make([]" + t + ", 0, r.SliceCap(n, int(unsafe.Sizeof(z))))\n\t}\n"
  if reuse
    $o = $o + "\tfor i := range n {\n\t\tvar e " + t + "\n\t\tif i < len(old) {\n\t\t\te = old[i]\n\t\t}\n"
  else
    $o = $o + "\tvar e " + t + "\n\tfor range n {\n"
  end
  ret $o + "\t\t" + each + "\n\t\tif r.Failed() {\n\t\t\t*p = nil\n\t\t\treturn\n\t\t}\n\t\tv = append(v, e)\n\t}\n\t*p = v\n"
end

# `e`, and `v`, an empty []t with the capacity Reader.SliceCap allows for n elements.
func make_slice(t)
  ret "\tvar e " + t + "\n\tv := make([]" + t + ", 0, r.SliceCap(n, int(unsafe.Sizeof(e))))\n"
end

# The rest of a sequence's write helper: null for nil, else its length and each element `e`, written by `each`.
func write_loop(each)
  ret "\tif v == nil {\n\t\tw.NullLength()\n\t\treturn\n\t}\n\tw.Length(len(v))\n\tfor _, e := range v {\n\t\t" + each + "\n\t}\n}\n"
end

# A slot's dispatch: the type id, then the body of one of the types the declared type allows. `read` and `write`
# name the functions, `slot` is the Go type of the slot, `iface` whether it is an interface (else a *T of the class
# `own`, whose id is `id`), `tracked` whether the declared type tracks references: its reference header comes first,
# then (for a new object) the type id. A tracked type in a slot that does not track has its header after its id.
func dispatch(read, write, slot, allowed, allowed_closed, iface, tracked, own, id)
  if tracked
    $o = "func " + read + "(r *nino.Reader) " + slot + " {\n"
    $o = $o + "\th := r.Ref()\n\tif h == 0 {\n\t\treturn nil\n\t}\n\tif h > 0 {\n\t\treturn nino.Back[" + slot + "](r, h)\n\t}\n"
    $o = $o + "\tswitch id := r.TypeID(); id {\n"
    for $t in allowed
      $o = $o + "\tcase " + $t.id + ":\n"
      if $t.kind == "raw" || $t.kind == "struct"
        $o = $o + "\t\treturn Read" + $t.name + "(r)\n"
      else
        $o = $o + "\t\treturn nino.ReadTrackedNew(r, &" + lower($t.name) + "Class)\n"
      end
    end
    for $k in allowed_closed
      $o = $o + "\tcase " + $k.id + ":\n"
      if $k.is_struct
        $o = $o + "\t\treturn " + $k.name + ".read(r)\n"
      else
        $o = $o + "\t\treturn nino.ReadClass(r, &" + $k.name + ".class)\n"
      end
    end
    $o = $o + "\tdefault:\n\t\tr.UnknownType(id)\n\t\treturn nil\n\t}\n}\n\n"
    # Tracked objects are read new.
    $o = $o + "func " + read + "Into(r *nino.Reader, v *" + slot + ") {\n\t*v = " + read + "(r)\n}\n\n"
  else
    # A new value: main's switch, a direct call per class. Reading into *v (DeserializeInto): a switch of its own, the
    # object *v holds read into when the data holds its type, else replaced (the fresh path keeps no branch for it).
    $o = "func " + read + "(r *nino.Reader) " + slot + " {\n\tswitch id := r.TypeID(); id {\n\tcase nino.NullTypeID:\n\t\treturn nil\n"
    $into = "func " + read + "Into(r *nino.Reader, v *" + slot + ") {\n\tswitch id := r.TypeID(); id {\n\tcase nino.NullTypeID:\n\t\t*v = nil\n"
    for $t in allowed
      $o = $o + "\tcase " + $t.id + ":\n"
      $into = $into + "\tcase " + $t.id + ":\n"
      if $t.kind == "raw" || $t.kind == "struct"
        $o = $o + "\t\treturn Read" + $t.name + "(r)\n"
        $into = $into + "\t\t*v = Read" + $t.name + "(r)\n"
      else if $t.tracked
        $o = $o + "\t\treturn nino.ReadTrackedClass(r, &" + lower($t.name) + "Class)\n"
        $into = $into + "\t\t*v = nino.ReadTrackedClass(r, &" + lower($t.name) + "Class)\n"
      else
        $o = $o + "\t\treturn read" + $t.name + "Class(r)\n"
        if iface
          $into = $into + "\t\tif p, ok := (*v).(*" + $t.name + "); ok && p != nil {\n" + class_into($t.name, "p", "\t\t\t") + "\t\t} else {\n\t\t\t*v = read" + $t.name + "Class(r)\n\t\t}\n"
        else
          $into = $into + "\t\tif *v != nil {\n" + class_into($t.name, "*v", "\t\t\t") + "\t\t} else {\n\t\t\t*v = read" + $t.name + "Class(r)\n\t\t}\n"
        end
      end
    end
    for $k in allowed_closed
      $o = $o + "\tcase " + $k.id + ":\n"
      $into = $into + "\tcase " + $k.id + ":\n"
      if $k.is_struct
        $o = $o + "\t\treturn " + $k.name + ".read(r)\n"
        $into = $into + "\t\t*v = " + $k.name + ".read(r)\n"
      else
        $o = $o + "\t\treturn nino.ReadClass(r, &" + $k.name + ".class)\n"
        $into = $into + "\t\t*v = nino.ReadClass(r, &" + $k.name + ".class)\n"
      end
    end
    $o = $o + "\tdefault:\n\t\tr.UnknownType(id)\n\t\treturn nil\n\t}\n}\n\n" + $into + "\tdefault:\n\t\tr.UnknownType(id)\n\t\t*v = nil\n\t}\n}\n\n"
  end
  if !iface
    # A class without subtypes: a *T, nil or the class itself.
    if tracked
      ret $o + "func " + write + "(w *nino.Writer, v " + slot + ") {\n\tif v == nil {\n\t\tw.I32(0)\n\t} else if w.Ref(v) {\n\t\tw.TypeID(" + id + ")\n\t\tnino.WriteClass(w, v, &" + lower(own) + "Class)\n\t}\n}\n"
    end
    ret $o + "func " + write + "(w *nino.Writer, v " + slot + ") {\n" + typed_write(id, own, "\t") + "}\n"
  end
  $o = $o + "func " + write + "(w *nino.Writer, v " + slot + ") {\n\tswitch v := v.(type) {\n\tcase nil:\n\t\t" + (tracked ? "w.I32(0)" : "w.TypeID(nino.NullTypeID)") + "\n"
  for $t in allowed
    if $t.kind == "raw" || $t.kind == "struct"
      $o = $o + "\tcase " + $t.name + ":\n\t\tw.TypeID(" + $t.id + ")\n\t\tWrite" + $t.name + "(w, v)\n"
    else if tracked
      $o = $o + "\tcase *" + $t.name + ":\n\t\tif v == nil {\n\t\t\tw.I32(0)\n\t\t} else if w.Ref(v) {\n\t\t\tw.TypeID(" + $t.id + ")\n\t\t\tnino.WriteClass(w, v, &" + lower($t.name) + "Class)\n\t\t}\n"
    else if $t.tracked
      $o = $o + "\tcase *" + $t.name + ":\n\t\tnino.WriteTypedTracked(w, " + $t.id + ", v, &" + lower($t.name) + "Class)\n"
    else
      $o = $o + "\tcase *" + $t.name + ":\n" + typed_write($t.id, $t.name, "\t\t")
    end
  end
  for $k in allowed_closed
    if $k.is_struct
      $o = $o + "\tcase " + closed_type($k) + ":\n\t\tw.TypeID(" + $k.id + ")\n\t\t" + $k.name + ".write(w, v)\n"
    else
      $o = $o + "\tcase *" + closed_type($k) + ":\n\t\tnino.WriteTyped(w, " + $k.id + ", v, &" + $k.name + ".class)\n"
    end
  end
  ret $o + "\tdefault:\n\t\tw.Fail(nino.CodeUnknownType, \"not a type the slot allows\")\n\t}\n}\n"
end

# Statements reading the body of the class `name` into a new instance and returning it: in place with a direct call
# to its body, or, from 128 open bodies on, through its Class (deferred or nested as .NET does).
func class_read(name)
  ret "\tv := new(" + name + ")\n\tif d, ok := r.EnterBody(); ok {\n\t\tread" + name + "Body(r, v)\n\t\tr.ExitBody(d)\n\t} else {\n\t\tnino.ReadClassInto(r, v, &" + lower(name) + "Class)\n\t}\n\treturn v\n"
end

# Statements (indented by `i`) reading the body of a class `name` into `x`, an existing *T (DeserializeInto), as
# class_read reads a new one.
func class_into(name, x, i)
  ret i + "if d, ok := r.EnterBody(); ok {\n" + i + "\tread" + name + "Body(r, " + x + ")\n" + i + "\tr.ExitBody(d)\n" + i + "} else {\n" + i + "\tnino.ReadClassInto(r, " + x + ", &" + lower(name) + "Class)\n" + i + "}\n"
end

# Statements writing the body of `v` (not nil), a *T of the class `name`, as class_read reads it.
func class_write(name)
  ret "\tif d, ok := w.EnterBody(); ok {\n\t\twrite" + name + "Body(w, v)\n\t\tw.ExitBody(d)\n\t} else {\n\t\tnino.WriteClass(w, v, &" + lower(name) + "Class)\n\t}\n"
end

# Statements writing `v`, a *T of the class `name` that does not track references, behind its type id `id`.
func typed_write(id, name, i)
  ret i + "if v == nil {\n" + i + "\tw.TypeID(nino.NullTypeID)\n" + i + "} else {\n" + i + "\tw.TypeID(" + id + ")\n" + i + "\twrite" + name + "Class(w, v)\n" + i + "}\n"
end

# The dispatch of a slot declared as a [NinoType] (ReadAnimal, WriteAnimal).
func slot_functions(c)
  $f = c.slot_functions
  $o = "// Read" + $f + " reads a value of a slot declared as " + c.model.full_name + ": a type id, then the body of a\n// type it allows.\n"
  ret $o + dispatch("Read" + $f, "Write" + $f, c.slot_name, c.allowed, c.allowed_closed, c.interface_slot, c.tracked, c.name, c.id)
end

# The dispatch of a slot of a closed generic type (readSlot0, writeSlot0).
func generic_slot_functions(g)
  $o = "// read" + upper_first(g.name) + " reads a value of a slot declared as " + g.runtime_name + ": a type id, then the body\n// of a type it allows.\n"
  ret $o + dispatch("read" + upper_first(g.name), "write" + upper_first(g.name), gotype(g.shape), g.allowed, g.allowed_closed, true, false, "", 0)
end

# The marker methods of the generic slots a type sits in (receiver `recv`): isShelf(int32).
func markers(c, recv)
  $o = ""
  for $m in c.markers
    $o = $o + "func (" + recv + ") is" + $m.slot_name + "(" + join_types($m.items) + ") {\n}\n\n"
  end
  ret $o
end

# The generic interface of a generic definition written behind a type id: its values are the types marked with it.
func generic_interface(c)
  ret "// " + c.generic_slot_name + " is a value of a slot declared as `" + c.runtime_name + "` with type arguments.\ntype " + c.generic_slot_name + c.type_params + " interface {\n\tnino.Typed\n\tis" + c.generic_slot_name + "(" + (array.join c.parameters ", ") + ")\n}\n"
end

# The codecs a generic type's codec is built from: those of its type arguments, then its slots'.
func codec_args(s)
  $all = args(s.items)
  if s.slots.size != 0
    $all = ($all == "" ? "" : $all + ", ") + args(s.slots)
  end
  ret $all
end

# A closed generic type in a slot: Box[int32].
func closed_type(k)
  ret type_of(k.shape.type).name + "[" + join_types(k.shape.items) + "]"
end

# A generic type: its struct, and its codec (`boxCodec[T]`), which holds the codecs of its type arguments (p0...),
# those it builds from them (d0...) and its own (self); BoxCodec builds one from the codecs of the arguments.
func generic_type(c)
