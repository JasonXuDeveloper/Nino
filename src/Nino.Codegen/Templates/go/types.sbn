    $o = $o + $recv + "writeBody(w *nino.Writer, v *" + $self + ") {\n" + write_members(c) + "}\n"
  else if c.kind == "class"
    $o = $o + $recv + "read(r *nino.Reader) " + $value + " {\n\treturn nino.ReadSealed(r, &c.class)\n}\n\n"
    $o = $o + $recv + "write(w *nino.Writer, v " + $value + ") {\n\tnino.WriteSealed(w, v, &c.class)\n}\n\n"
    $o = $o + $recv + "readBody(r *nino.Reader, v *" + $self + ") {\n" + read_members(c) + "}\n\n"
    $o = $o + $recv + "writeBody(w *nino.Writer, v *" + $self + ") {\n" + write_members(c) + "}\n"
  else
