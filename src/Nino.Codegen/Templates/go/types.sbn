    $o = $o + $recv + "read(r *nino.Reader) (v " + $self + ") {\n\tif !r.EnterStruct() {\n\t\treturn v\n\t}\n" + read_members(c) + "\tr.ExitStruct()\n\treturn v\n}\n\n"
    $o = $o + $recv + "write(w *nino.Writer, v " + $self + ") {\n\tif !w.EnterStruct() {\n\t\treturn\n\t}\n" + write_members(c) + "\tw.ExitStruct()\n}\n"
  end
  for $d in $derived
    if !$d.generic
      $o = $o + "\n" + helper_body(go_helper("(c *" + $codec + c.type_args + ") read" + upper_first($d.name), "read", $d.shape))
      $o = $o + "\n" + helper_body(go_helper("(c *" + $codec + c.type_args + ") write" + upper_first($d.name), "write", $d.shape))
    end
  end
  ret $o
end

# The receiver of a type's methods: the pointer of a class, the value of a struct.
func receiver(c)
  if c.is_struct
    ret c.name
  end
  ret "*" + c.name
end
