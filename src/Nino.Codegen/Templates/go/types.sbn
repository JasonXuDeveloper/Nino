  end
  if c.kind == "struct"
    # A struct: no header, and no class body (it does not count toward the depth).
    "func Read" + c.name + "(r *nino.Reader) (v " + c.name + ") {\n\tRead" + c.name + "Into(r, &v)\n\treturn v\n}\n\n"
    "// Read" + c.name + "Into reads a value into *v, its members into what they hold (DeserializeInto).\nfunc Read" + c.name + "Into(r *nino.Reader, v *" + c.name + ") {\n"
    if c.counted
      "\tif !r.EnterStruct() {\n\t\treturn\n\t}\n"
    end
    read_members(c)
    if c.counted
      "\tr.ExitStruct()\n"
    end
    "}\n\n"
    "func Write" + c.name + "(w *nino.Writer, v " + c.name + ") {\n"
    if c.counted
      "\tif !w.EnterStruct() {\n\t\treturn\n\t}\n"
    end
    write_members(c)
    if c.counted
      "\tw.ExitStruct()\n"
    end
    "}\n"
    continue
  end
  if c.kind == "class" && c.tracked
    # Its reference header, then its body for an object not written before.
    "func Read" + c.name + "(r *nino.Reader) *" + c.name + " {\n\treturn nino.ReadTracked(r, &" + lower(c.name) + "Class)\n}\n\n"
    "// Read" + c.name + "Into reads a value into *v (DeserializeInto): a tracked object is read new.\nfunc Read" + c.name + "Into(r *nino.Reader, v **" + c.name + ") {\n\t*v = Read" + c.name + "(r)\n}\n\n"
    "func Write" + c.name + "(w *nino.Writer, v *" + c.name + ") {\n\tnino.WriteTracked(w, v, &" + lower(c.name) + "Class)\n}\n\n"
  else if c.kind == "class"
    # Its presence byte, then its body in place with a direct call, or (128 bodies deep) through its Class, which
    # defers it as .NET does.
    "func Read" + c.name + "(r *nino.Reader) *" + c.name + " {\n\tif !r.Present() {\n\t\treturn nil\n\t}\n" + class_read(c.name) + "}\n\n"
    "func Write" + c.name + "(w *nino.Writer, v *" + c.name + ") {\n\tif v == nil {\n\t\tw.U8(0)\n\t\treturn\n\t}\n\tw.U8(1)\n" + class_write(c.name) + "}\n\n"
    "// Read" + c.name + "Into reads a value into *v, the object it points to read in place (DeserializeInto).\nfunc Read" + c.name + "Into(r *nino.Reader, v **" + c.name + ") {\n\tif !r.Present() {\n\t\t*v = nil\n\t\treturn\n\t}\n\tif *v == nil {\n\t\t*v = new(" + c.name + ")\n\t}\n" + class_into(c.name, "*v", "\t") + "}\n\n"
  else
    if c.interface_slot
      "// " + c.slot_name + " is a value of a slot declared as `" + c.model.full_name + "`: it or a type deriving from it.\ntype " + c.slot_name + " interface {\n\tnino.Typed\n\tis" + c.slot_name + "()\n}\n\n"
    end
    slot_functions(c) + "\n"
  end
  if (c.kind == "class" || c.kind == "typeid") && !c.tracked
    # The body after a type id, for the dispatches of the slots that allow it (a sealed class's Read and Write keep
    # it inline: one call fewer on the common path).
    "// read" + c.name + "Class reads the body of a " + c.name + " (after its type id) into a new instance.\n"
    "func read" + c.name + "Class(r *nino.Reader) *" + c.name + " {\n" + class_read(c.name) + "}\n\n"
    "// write" + c.name + "Class writes the body of v (not nil, after its type id).\n"
    "func write" + c.name + "Class(w *nino.Writer, v *" + c.name + ") {\n" + class_write(c.name) + "}\n\n"
  end
  "func read" + c.name + "Body(r *nino.Reader, v *" + c.name + ") {\n" + read_members(c) + "}\n\n"
  "func write" + c.name + "Body(w *nino.Writer, v *" + c.name + ") {\n" + write_members(c) + "}\n"
end

if uses_object
  "\nfunc readObject(r *nino.Reader) nino.Typed {\n\tv, _ := nino.ReadAny(r, objects).(nino.Typed)\n\treturn v\n}\n"
  "\nfunc writeObject(w *nino.Writer, v nino.Typed) {\n\tnino.WriteAny(w, v, objects)\n}\n"
end

# The slots of closed generic types written behind type ids.
for g in generic_slots
  "\n" + generic_slot_functions(g)
end

if uses_elements
  "\n// ninoElements checks the elements of a [NinoType] collection: null is invalid (the collection is the object).\n"
  "func ninoElements[T any](r *nino.Reader, v []T) []T {\n\tif v == nil && !r.Failed() {\n\t\tr.Fail(nino.CodeInvalidData, \"null elements of a collection\")\n\t}\n\treturn v\n}\n"
  "\n// ninoNonNil writes nil elements as an empty collection.\nfunc ninoNonNil[T any](v []T) []T {\n\tif v == nil {\n\t\treturn []T{}\n\t}\n\treturn v\n}\n"
end

# The functions shared by values of one shape.
$i = 0
while $i < helper_count()
  "\n" + helper_body(helper_at($i))
  $i = $i + 1
end

for n in tuples
  $params = []
  $fields = []
  for $k in 1..n
    $params = array.add $params ("T" + $k)
  end
  "\n// NinoTuple" + n + " is a ValueTuple or Tuple of " + n + " items.\ntype NinoTuple" + n + "[" + (array.join $params ", ") + " any] struct {\n"
  for $k in 1..n
    "\tItem" + $k + " T" + $k + "\n"
  end
  "}\n"
end

if uses_grid
  "\n// NinoGrid is a multi-dimensional array: its lengths and its items in row-major order.\ntype NinoGrid[T any] struct {\n\tLengths []int\n\tItems   []T\n}\n"
  "\n// readGrid reads a grid's shape and makes its items, which the caller reads: nil for null and on a failure.\n"
  "func readGrid[T any](r *nino.Reader, rank, minSize int) *NinoGrid[T] {\n\ts, ok := r.ReadShape(rank, minSize)\n\tif !ok {\n\t\treturn nil\n\t}\n"
  "\t// ReadShape checked the element count against the bytes left.\n\treturn &NinoGrid[T]{Lengths: append([]int(nil), s.Dims[:rank]...), Items: make([]T, s.Total)}\n}\n"
  "\n// writeGrid writes a grid's shape (null for nil): whether the caller writes its items next.\n"
  "func writeGrid[T any](w *nino.Writer, g *NinoGrid[T], rank int) bool {\n\tif g == nil {\n\t\tw.NullLength()\n\t\treturn false\n\t}\n"
  "\ttotal := 1\n\tfor _, n := range g.Lengths {\n\t\tif n < 0 {\n\t\t\ttotal = -1\n\t\t\tbreak\n\t\t}\n\t\ttotal *= n\n\t}\n"
  "\tif len(g.Lengths) != rank || total != len(g.Items) {\n\t\tw.Fail(nino.CodeInvalidValue, \"grid lengths do not match its items\")\n\t\treturn false\n\t}\n"
  "\tw.WriteShape(g.Lengths...)\n\treturn true\n}\n"
end
~}}

// keyString reads a string dictionary key: null is invalid (.NET's dictionaries reject a null key).
func keyString(r *nino.Reader) string {
	s, ok := r.NullableString()
	if !ok && !r.Failed() {
		r.Fail(nino.CodeInvalidData, "null dictionary key")
	}
	return s
}

// keyUtf8 reads a [NinoUtf8] string dictionary key.
func keyUtf8(r *nino.Reader) string {
	s, ok := r.NullableUTF8()
	if !ok && !r.Failed() {
		r.Fail(nino.CodeInvalidData, "null dictionary key")
	}
	return s
}

// Values inside raw memory with invalid bit patterns, checked as when read alone.

func decimalAt(r *nino.Reader, b []byte) nino.Decimal {
	d := nino.DecimalAt(b)
	if !d.Valid() {
		r.Fail(nino.CodeInvalidData, "invalid decimal")
		return nino.Decimal{}
	}
	return d
}

func dateTimeAt(r *nino.Reader, b []byte) nino.DateTime {
	d := nino.DateTime(le.Uint64(b))
	if !d.Valid() {
		r.Fail(nino.CodeInvalidData, "invalid DateTime")
		return 0
	}
	return d
}

func dateOnlyAt(r *nino.Reader, b []byte) nino.DateOnly {
	d := nino.DateOnly(int32(le.Uint32(b)))
	if !d.Valid() {
		r.Fail(nino.CodeInvalidData, "invalid DateOnly")
		return 0
	}
	return d
}

func timeOnlyAt(r *nino.Reader, b []byte) nino.TimeOnly {
	t := nino.TimeOnly(int64(le.Uint64(b)))
	if !t.Valid() {
		r.Fail(nino.CodeInvalidData, "invalid TimeOnly")
		return 0
	}
	return t
}

{{~ if uses_args ~}}
// NinoArg is the codec of a type argument of a generic type: how its values are read and written, and the fewest
// bytes one takes.
type NinoArg[T any] struct {
	Read    func(*nino.Reader) T
	Write   func(*nino.Writer, T)
	MinSize int
}

{{~ end ~}}
// NinoCodec reads and writes values of one type, as any.
type NinoCodec struct {
	Read  func(*nino.Reader) any
	Write func(*nino.Writer, any)
	// ReadInto reads a value into v, a value of the type (DeserializeInto), and returns it.
	ReadInto func(r *nino.Reader, v any) any
}

func codecOf[T any](read func(*nino.Reader) T, readInto func(*nino.Reader, *T), write func(*nino.Writer, T)) NinoCodec {
	return NinoCodec{
		Read: func(r *nino.Reader) any {
			return read(r)
		},
		ReadInto: func(r *nino.Reader, v any) any {
			x, _ := v.(T)
			readInto(r, &x)
			return x
		},
		Write: func(w *nino.Writer, v any) {
			x, _ := v.(T)
			write(w, x)
		},
	}
}

// NinoCodecOf returns the codec of the type of that .NET name (Namespace.Outer+Inner), as a member of its type is
// written (with its header).
func NinoCodecOf(name string) (NinoCodec, bool) {
	switch name {
{{~
for c in types
  if c.parameters.size != 0
    continue
  end
  "\tcase " + go_string(c.runtime_name) + ":\n"
  if c.kind == "typeid"
    "\t\treturn codecOf(Read" + c.slot_functions + ", Read" + c.slot_functions + "Into, Write" + c.slot_functions + "), true\n"
  else
    $f = c.is_abstract ? c.slot_functions : c.name
    "\t\treturn codecOf(Read" + $f + ", Read" + $f + "Into, Write" + $f + "), true\n"
  end
end
~}}
	}
	return NinoCodec{}, false
}
