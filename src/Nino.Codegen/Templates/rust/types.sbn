{{~
# The generated Rust: every decision is RustTarget's (which types, their shapes, names, keys, deferral); this
# template only spells them, in the shape of runtimes/rust/tests/conformance/types.rs.

prim_types = {
  Bool: "bool", I8: "i8", U8: "u8", I16: "i16", U16: "u16", I32: "i32", U32: "u32", I64: "i64", U64: "u64",
  F16: "nino::Half", F32: "f32", F64: "f64", Char: "u16", Decimal: "nino::Decimal", Guid: "nino::Guid",
  DateTime: "nino::DateTime", TimeSpan: "nino::TimeSpan", DateOnly: "nino::DateOnly", TimeOnly: "nino::TimeOnly",
  I128: "i128", U128: "u128", NInt: "i64", NUInt: "u64", Rune: "nino::Rune"
}

# A collection's Rust type without the Option that holds null.
func bare(s)
  case s.kind
  when "seq"
    if s.mode == "rawnullables"
      ret "nino::RawNullables<" + rtype(s.element) + ">"
    else if s.mode == "set"
      ret (std_maps ? "std::collections::HashSet<" : "indexmap::IndexSet<") + rtype(s.element) + ">"
    end
    ret "Vec<" + rtype(s.element) + ">"
  when "map"
    ret (std_maps ? "std::collections::HashMap<" : "indexmap::IndexMap<") + rtype(s.key) + ", " + rtype(s.value) + ">"
  end
end

# The Rust type of a type a slot allows: a type with a layout, or a generic type with its arguments.
func variant_type(a)
  if a.shape
    ret generic(a.shape)
  end
  ret name(a.type)
end

# A generic type with its arguments, then the enums of the slots it holds.
func generic(s)
  $parts = []
  for $i in s.items
    $parts = array.add $parts (rtype($i))
  end
  for $i in s.slots
    $parts = array.add $parts $i.ref_name
  end
  ret name(s.type) + "<" + (array.join $parts ", ") + ">"
end

func rtype(s)
  case s.kind
  when "prim"
    ret prim_types[s.primitive]
  when "enum"
    ret rtype(s.inner)
  when "rawstruct"
    ret name(s.struct)
  when "tuple"
    $parts = []
    for $i in s.items
      $parts = array.add $parts (rtype($i))
    end
    ret "(" + (array.join $parts ", ") + (s.items.size == 1 ? "," : "") + ")"
  when "string"
    ret s.wide ? "Option<nino::WideString>" : "Option<String>"
  when "keystring"
    ret s.wide ? "nino::WideString" : "String"
  when "utf8"
    ret "Option<nino::Utf8>"
  when "keyutf8"
    ret "nino::Utf8"
  when "object"
    ret "Option<AnyObject>"
  when "struct"
    ret name(s.type)
  when "param"
    ret s.parameter
  when "generic"
    ret generic(s)
  when "genericclass"
    ret "Option<Box<" + generic(s) + ">>"
  when "class"
    ret "Option<Box<" + name(s.type) + ">>"
  when "shared"
    ret "Option<nino::Shared<" + name(s.type) + ">>"
  when "slot"
    ret "Option<" + name(s.type) + "Ref>"
  when "genslot"
    ret "Option<" + s.ref_name + ">"
  when "named"
    ret "Option<" + s.named.name + ">"
  when "nullable"
    ret "Option<" + rtype(s.inner) + ">"
  when "seq", "map"
    ret "Option<" + bare(s) + ">"
  when "grid"
    ret "Option<nino::Grid<" + rtype(s.element) + ", " + s.rank + ">>"
  when "bigint"
    ret "nino::BigInteger"
  when "version"
    ret "Option<nino::Version>"
  when "datetimeoffset"
    ret "nino::DateTimeOffset"
  end
end

# Reading a member into `self`: through read_in when a class body inside may be deferred.
func read(m)
  if m.shape.may_defer
    ret "r.read_in(nino::field!(Self, " + m.name + "))?"
  end
  ret "r.read()?"
end

# A variant of a slot's enum: a tracked class is shared, any other type boxed.
func variant_box(a)
  if a.shared
    ret "nino::Shared<" + variant_type(a) + ">"
  end
  ret "Box<" + variant_type(a) + ">"
end

# The statement reading a [NinoType] collection's elements: never null (the collection is the object itself).
func read_elements(t)
  if t.elements_member
    ret "        self." + t.elements_member.name + " = " + read(t.elements_member) + ";\n"
  end
  ret ""
end

func write_elements(t)
  if t.elements_member
    ret "        w.write(&self." + t.elements_member.name + ")?;\n"
  end
  ret ""
end

# NinoWrite's PREFETCH and prefetch stages, for a type with members that may point elsewhere (text, a list, a class,
# or a type that may hold one): their bytes summed and their stages in turn; none for a type of numbers.
func prefetch(t)
  $fields = []
  $types = []
  if t.elements_member
    $fields = array.add $fields t.elements_member.name
    $types = array.add $types (bare(t.elements_member.shape))
  end
  for $m in t.members
    if (["string", "keystring", "seq", "class", "genericclass", "struct", "generic", "param", "nullable"] | array.contains $m.shape.kind) && !($m.shape.wide)
      $fields = array.add $fields $m.name
      $types = array.add $types (rtype($m.shape))
    end
  end
  if $fields.size == 0
    ret ""
  end
  $o = "    const PREFETCH: usize = 0usize"
  for $ty in $types
    $o = $o + "\n        .saturating_add(<" + $ty + " as NinoWrite>::PREFETCH)"
  end
  $o = $o + ";\n\n    fn prefetch(&self) {\n"
  for $f in $fields
    $o = $o + "        self." + $f + ".prefetch();\n"
  end
  $o = $o + "    }\n\n    fn prefetch_members(&self) {\n"
  for $f in $fields
    $o = $o + "        self." + $f + ".prefetch_members();\n"
  end
  ret $o + "    }\n\n"
end

# MAY_DEFER of a struct: a member holding a type parameter asks its argument.
func may_defer(t)
  $parts = []
  for $m in t.members
    if $m.shape.may_defer
      if !$m.open
        ret "true"
      end
      $parts = array.add $parts ("<" + rtype($m.shape) + " as NinoRead>::MAY_DEFER")
    end
  end
  ret array.join (array.uniq $parts) " || "
end

func derive(extra)
  $o = "#[derive(" + extra + ")]\n"
  if serde
    $o = $o + "#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize)"
    if serde_rename_all
      $o = $o + ", serde(rename_all = \"" + serde_rename_all + "\")"
    end
    $o = $o + ")]\n"
  end
  ret $o
end

func derive_enum(extra)
  $o = "#[derive(" + extra + ")]\n"
  if serde
    $o = $o + "#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\n"
  end
  ret $o
end

func field(f, type)
  $o = ""
  if f.serde_rename
    $o = "    #[cfg_attr(feature = \"serde\", serde(rename = " + rust_string(f.serde_rename) + "))]\n"
  end
  ret $o + "    pub " + f.name + ": " + type + ","
end

func ids(t)
  $o = "impl" + t.declared_generics + " " + t.name + t.generics + " {\n"
  if t.parameters.size == 0
    $o = $o + "    /// The .NET type's id, written in front of its body in a polymorphic slot.\n"
    $o = $o + "    pub const TYPE_ID: i32 = " + hex(t.id) + "u32 as i32;\n"
  end
  $o = $o + "    /// The .NET type's name (`Namespace.Outer+Inner`).\n"
  $o = $o + "    pub const NINO_TYPE_NAME: &str = " + rust_string(t.runtime_name) + ";\n"
  $o = $o + "    /// The layout this code was generated from (`NinoTypeLayout`).\n"
  $o = $o + "    pub const NINO_LAYOUT: &str = " + rust_string(t.layout) + ";\n"
  ret $o + "}"
end
~}}
