/// Runs a generic function on the Rust type of a .NET type ([`with_nino_type`]).
pub trait NinoVisit<R> {
    fn visit<T: NinoRead + NinoWrite + 'static>(self) -> R;
}

/// Runs `f` with the Rust type a value declared as the .NET type `name` (`Namespace.Outer+Inner`) is read as, or
/// returns `None` for a type not generated.
pub fn with_nino_type<R>(name: &str, f: impl NinoVisit<R>) -> Option<R> {
