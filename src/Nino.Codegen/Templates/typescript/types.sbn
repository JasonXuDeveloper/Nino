{{~
# The TypeScript of an assembly's [NinoType]s (TypeScriptTarget): enums, raw structs, interfaces and classes, the
# registry of the types written behind a type id, a codec per type, then the functions values of one shape share.
include "shapes.sbn"

# The type arguments of a closed generic type, and their codecs.
func closed_args(s)
  $types = []
  for $item in s.items
    $types = array.add $types (ts($item))
  end
  ret array.join $types ", "
end

func closed_codecs(s)
  $args = []
  for $item in s.items
    $args = array.add $args (codec($item))
  end
  for $slot in s.slots
    $args = array.add $args $slot.field
  end
  ret array.join $args ", "
end

# A class body (`readBody$X`, `writeBody$X`) or a struct (`readX`, `writeX`): its members, without the header.
func body(c)
  $n = c.name
  # A generic type: `Box<T>`, its code takes the codecs of its arguments (`c`) and passes them on.
  $t = c.self
  $tp = c.type_params
  $ca = c.codecs_argument
  $o = ""
  # An empty body leaves its parameters unused: they are named with a `_`, as noUnusedParameters wants.
  $empty = c.members.size == 0 && !c.elements
  $r = $empty && c.format == "positional" && !c.counted ? "_r" : "r"
  $w = $empty && c.format == "positional" && !c.counted ? "_w" : "w"
  $v = $empty ? "_v" : "v"
  $cs = $empty ? (string.replace c.codecs ", c:" ", _c:") : c.codecs
  $readBody = "readBody$" + $n
  # A generic type some of whose closed types sit in slots: its codecs name the class to build (their subclass).
  $new = c.closed.size != 0 ? "c.type" : $t
  $writeBody = "writeBody$" + $n
  if $ca != ""
    $readBody = "(r, v) => readBody$" + $n + "(r, v, c)"
    $writeBody = "(w, v) => writeBody$" + $n + "(w, v, c)"
  end
  # A tracked class records the object as soon as it exists: its members may refer back to it.
  $track = c.tracked ? "  r.track(v);\n" : ""
  if c.is_class_body
    $o = $o + "function read" + $n + $tp + "(r: NinoReader" + c.codecs + "): " + $t + " {\n"
    if c.nests
      $o = $o + "  const v = new " + $new + "(), depth = r.depth;\n" + $track + "  if (depth >= 128) return r." + c.later + "(v, " + $readBody + ");\n"
      $o = $o + "  r.depth = depth + 1;\n  readBody$" + $n + "(r, v" + $ca + ");\n  r.exit(depth);\n"
    else
      $o = $o + "  const v = new " + $new + "();\n" + $track + "  if (r.depth >= 128) return r." + c.later + "(v, " + $readBody + ");\n"
      $o = $o + "  readBody$" + $n + "(r, v" + $ca + ");\n"
    end
    $o = $o + "  return v;\n}\n\n"
    $o = $o + "function write" + $n + $tp + "(w: NinoWriter, v: " + $t + c.codecs + "): void {\n"
    if c.nests
      $o = $o + "  const depth = w.depth;\n  if (depth >= 128) {\n    w." + c.later + "(v, " + $writeBody + ");\n    return;\n  }\n"
      $o = $o + "  w.depth = depth + 1;\n  writeBody$" + $n + "(w, v" + $ca + ");\n  w.exit(depth);\n"
    else
      $o = $o + "  if (w.depth >= 128) w." + c.later + "(v, " + $writeBody + ");\n  else writeBody$" + $n + "(w, v" + $ca + ");\n"
    end
    $o = $o + "}\n\n"
    $o = $o + "function readBody$" + $n + $tp + "(" + $r + ": NinoReader, " + $v + ": " + $t + $cs + "): void {\n"
  else
    $o = $o + "function read" + $n + $tp + "(" + $r + ": NinoReader" + $cs + "): " + $t + " {\n"
    if c.counted
      $o = $o + "  r.enterStruct();\n"
    end
    $o = $o + "  const v = new " + $new + "();\n"
  end

  # A [NinoType] collection: its elements first (inside a keyed body's region, outside a version tolerant one's).
  $elements = c.elements ? "  v.$elements = r.elements(" + read(c.elements) + ");\n" : ""
  if c.format == "keyed"
    # Members by key, in any order; a known member's value fills its entry exactly, a key this version does not know
    # is skipped.
    $o = $o + "  const end = r.region();\n" + $elements + "  while (r.pos < end) {\n    const key = r.i32(), member = r.region();\n    switch (key) {\n"
    for $m in c.members
      for $key in $m.model.all_keys
        $o = $o + "      case " + $key + ":\n"
      end
      $o = $o + "        v." + $m.name + " = " + read($m.shape) + ";\n        r.endMember(member);\n        continue;\n"
    end
    $o = $o + "    }\n    r.endRegion(member);\n  }\n  r.endRegion(end);\n"
  else if c.format == "tolerant"
    # Members written by an older version end early; those of a newer one are skipped.
    $o = $o + $elements + "  const end = r.region();\n"
    for $m in c.members
      $o = $o + "  if (r.pos < end) v." + $m.name + " = " + read($m.shape) + ";\n"
    end
    $o = $o + "  r.endRegion(end);\n"
  else
    # Each run of fixed-size members takes its bytes at once and reads them at their offsets.
    $o = $o + $elements
    $decl = c.at_declaration
    for $run in c.runs
      if $run.items.size == 1
        $o = $o + "  v." + $run.items[0].member.name + " = " + read($run.items[0].member.shape) + ";\n"
      else
        $o = $o + "  " + $decl + " = r.take(" + $run.size + ");\n"
        $decl = "at"
        for $item in $run.items
          $o = $o + "  v." + $item.member.name + " = " + read_at($item.member.shape, $item.offset) + ";\n"
        end
      end
    end
  end
  if c.counted
    $o = $o + "  r.exitStruct();\n"
  end
  if c.is_class_body
    $o = $o + "}\n\n"
    $o = $o + "function writeBody$" + $n + $tp + "(" + $w + ": NinoWriter, " + $v + ": " + $t + $cs + "): void {\n"
  else
    $o = $o + "  return v;\n}\n\n"
    $o = $o + "function write" + $n + $tp + "(" + $w + ": NinoWriter, " + $v + ": " + $t + $cs + "): void {\n"
  end
  if c.counted
    $o = $o + "  w.enterStruct();\n"
  end
  $elements = c.elements ? "  " + stmt(write(c.elements, "v.$elements")) + "\n" : ""
  if c.format != "keyed"
    $o = $o + $elements
  end
  if c.format != "positional"
    $o = $o + "  const start = w.region();\n"
  end
  if c.format == "keyed"
    $o = $o + $elements
    for $m in c.members
      $o = $o + "  w.i32(" + $m.model.key + ");\n  const " + $m.name + "$ = w.region();\n  " + stmt(write($m.shape, "v." + $m.name)) + "\n  w.endRegion(" + $m.name + "$);\n"
    end
  else
    # Each run of fixed-size members reserves its bytes at once and writes them at their offsets.
    $decl = c.at_declaration
    for $run in c.runs
      if $run.items.size == 1
        $o = $o + "  " + stmt(write($run.items[0].member.shape, "v." + $run.items[0].member.name)) + "\n"
      else
        $o = $o + "  " + $decl + " = " + reserve($run.size, $run.zeroed) + ";\n"
        $decl = "at"
        for $item in $run.items
          $o = $o + "  " + stmt(write_at($item.member.shape, $item.offset, "v." + $item.member.name)) + "\n"
        end
      end
    end
  end
  if c.format != "positional"
    $o = $o + "  w.endRegion(start);\n"
  end
  if c.counted
    $o = $o + "  w.exitStruct();\n"
  end
  ret $o + "}\n\n"
end

# The body of a type written behind a type id, without its header. `form3`: behind a type id its declared type does not
# track, where a tracked type's reference header follows the id.
func read_body(c, form3)
  if c.raw_shape
    ret read(c.raw_shape)
  end
  if form3 && c.tracked
    ret "r.trackedOf(" + c.name + ", read" + c.name + ")"
  end
  ret "read" + c.name + "(r)"
end

func write_body(c, v, form3)
  if c.raw_shape
    ret write(c.raw_shape, v)
  end
  if form3 && c.tracked
    ret "if (w.ref(" + v + ")) write" + c.name + "(w, " + v + ")"
  end
  ret "write" + c.name + "(w, " + v + ")"
end

# The codec of a slot (after `NinoCodec<T | null> = `): the type id, then the body of one of the types it allows, by
# its class when written. `backref`: for a declared type that tracks references, the expression of the object a back
# reference names; its reference header comes first then, and the bodies follow the id without one.
func typeid_codec(assignable, closed, backref)
  $tracked = backref != null
  $o = "{\n  read: (r) => {\n"
  if $tracked
    $o = $o + "    const h = r.ref();\n    if (h === 0) return null;\n    if (h > 0) return " + backref + ";\n"
    $o = $o + "    const id = r.i32();\n    switch (id) {\n"
  else
    $o = $o + "    const id = r.i32();\n    switch (id) {\n      case 0:\n        return null;\n"
  end
  for $t in assignable
    $o = $o + "      case " + $t.model.type_id + ":\n        return " + read_body($t, !$tracked) + ";\n"
  end
  for $k in closed
    $o = $o + "      case " + $k.id + ":\n        return read" + name($k.shape.type) + "(r, " + $k.codecs + ");\n"
  end
  $o = $o + "    }\n    throw types.unreadable(id);\n  },\n  write: (w, v) => {\n"
  if $tracked
    $o = $o + "    if (!w.ref(v)) return;\n"
  else
    $o = $o + "    if (v === null || v === undefined) {\n      w.i32(0);\n      return;\n    }\n"
  end
  $o = $o + "    switch (v.constructor) {\n"
  for $t in assignable
    $o = $o + "      case " + $t.name + ":\n        w.i32(" + $t.model.type_id + ");\n        " + stmt(write_body($t, "v as " + $t.name, !$tracked)) + "\n        return;\n"
  end
  for $k in closed
    $o = $o + "      case " + $k.name + ":\n        w.i32(" + $k.id + ");\n        write" + name($k.shape.type) + "(w, v as " + $k.name + ", " + $k.codecs + ");\n        return;\n"
  end
  ret $o + "    }\n    throw types.unwritable(v);\n  },\n};\n"
end

# A function shared by every value of one shape.
func helper_body(h)
  $s = h.shape
  $n = h.name
  $o = ""
  if h.mode == "read"
    if $s.kind == "seq"
      $o = "function " + $n + h.type_params + "(r: NinoReader" + h.codecs + "): " + seq_ts($s) + " | null {\n  const length = r.length();\n  if (length < 0) return null;\n"
      if $s.set
        $o = $o + "  const values = new Set<" + ts($s.element) + ">();\n"
        $add = "values.add("
        $close = ")"
      else
        $o = $o + "  const values = new Array<" + ts($s.element) + ">(length);\n"
        $add = "values[i] = "
        $close = ""
      end
      if $s.element.fixed
        $o = $o + "  for (let i = 0, at = r.take(length * " + $s.element.size + "); i < length; i++, at += " + $s.element.size + ") " + $add + read_at($s.element, 0) + $close + ";\n"
      else
        $o = $o + "  for (let i = 0; i < length; i++) " + $add + read($s.element) + $close + ";\n"
      end
      if $s.set
        # An element read twice (the set holds fewer than were read) is invalid data, as in .NET.
        $o = $o + "  if (values.size !== length) throw r.duplicateKey();\n"
      end
      ret $o + "  return values;\n}\n"
    else if $s.kind == "map"
      $o = "function " + $n + h.type_params + "(r: NinoReader" + h.codecs + "): " + map_ts($s) + " | null {\n  const length = r.length();\n  if (length < 0) return null;\n  const map = new " + map_ts($s) + "();\n"
      if $s.key.fixed && $s.value.fixed
        $size = $s.key.size + $s.value.size
        $o = $o + "  for (let i = 0, at = r.take(length * " + $size + "); i < length; i++, at += " + $size + ") map.set(" + read_at($s.key, 0) + ", " + read_at($s.value, $s.key.size) + ");\n"
      else
        $o = $o + "  for (let i = 0; i < length; i++) {\n    const key = " + read($s.key) + ";\n    map.set(key, " + read($s.value) + ");\n  }\n"
      end
      # A key read twice (the map holds fewer than were read) is invalid data, as in .NET.
      ret $o + "  if (map.size !== length) throw r.duplicateKey();\n  return map;\n}\n"
    end
    # A value of fixed size: takes its bytes.
    ret "function " + $n + "(r: NinoReader): " + ts($s) + " {\n  const at = r.take(" + $s.size + ");\n  return " + read_at($s, 0) + ";\n}\n"
  end

  if $s.kind == "seq"
    if $s.set
      $input = "ReadonlySet<" + ts($s.element) + ">"
      $length = "values.size"
      # Arrays by index: V8 runs an index loop faster than an array iterator (Chromium most).
      $loop = "  for (const value of values) {\n"
    else
      $input = "readonly " + paren(ts($s.element)) + "[]"
      $length = "values.length"
      $loop = "  for (let i = 0; i < values.length; i++) {\n    const value = values[i];\n"
    end
    $o = "function " + $n + h.type_params + "(w: NinoWriter, values: " + $input + " | null" + h.codecs + "): void {\n  if (values === null || values === undefined) {\n    w.i32(-1);\n    return;\n  }\n  w.i32(" + $length + ");\n"
    if $s.element.fixed
      $o = $o + "  let at = " + reserve($length + " * " + $s.element.size, $s.element.zeroed) + ";\n" + $loop + "    " + stmt(write_at($s.element, 0, "value")) + "\n    at += " + $s.element.size + ";\n  }\n"
    else
      $o = $o + $loop + "    " + stmt(write($s.element, "value")) + "\n  }\n"
    end
    ret $o + "}\n"
  else if $s.kind == "map"
    $o = "function " + $n + h.type_params + "(w: NinoWriter, map: ReadonlyMap<" + ts($s.key) + ", " + ts($s.value) + "> | null" + h.codecs + "): void {\n  if (map === null || map === undefined) {\n    w.i32(-1);\n    return;\n  }\n  w.i32(map.size);\n"
    if $s.key.fixed && $s.value.fixed
      $size = $s.key.size + $s.value.size
      $o = $o + "  let at = " + reserve("map.size * " + $size, $s.key.zeroed || $s.value.zeroed) + ";\n  for (const [key, value] of map) {\n    " + stmt(write_at($s.key, 0, "key")) + "\n    " + stmt(write_at($s.value, $s.key.size, "value")) + "\n    at += " + $size + ";\n  }\n"
    else
      $o = $o + "  for (const [key, value] of map) {\n    " + stmt(write($s.key, "key")) + "\n    " + stmt(write($s.value, "value")) + "\n  }\n"
    end
    ret $o + "}\n"
  end
  ret "function " + $n + "(w: NinoWriter, v: " + ts($s) + "): void {\n  const at = " + reserve($s.size, $s.zeroed) + ";\n  " + stmt(write_at($s, 0, "v")) + "\n}\n"
end
~}}
// Generated by nino-gen from {{ source }}: its [NinoType]s, read and written as Nino serializes them in .NET.
// Do not edit: it is overwritten on every build.

import { NinoReader, NinoRegistry, NinoWriter, type NinoCodec } from "{{ runtime_module }}";

const types = new NinoRegistry();

{{~
for e in enums
  "/** `" + e.model.full_name + "`. */\nexport const " + e.name + " = {\n"
  for $c in e.model.constants
    "  " + $c.name + ": " + $c.value + (e.big ? "n" : "") + ",\n"
  end
  "} as const;\n"
  # A flags value is any combination of them.
  if e.model.flags
    "export type " + e.name + " = " + (e.big ? "bigint" : "number") + ";\n\n"
  else
    "export type " + e.name + " = (typeof " + e.name + ")[keyof typeof " + e.name + "];\n\n"
  end
end

for s in raw_structs
  "/** `" + s.model.full_name + "`, copied as raw memory (" + s.model.size + " bytes). */\nexport class " + s.name + " {\n"
  for $f in s.fields
    "  " + $f.name + ": " + ts($f.shape) + " = " + def($f.shape) + ";\n"
  end
  "}\n\n"
  # Each field at its offset of the bytes the caller took (zeroed, if the struct has padding).
  "function read" + s.name + "(r: NinoReader, at: number): " + s.name + " {\n  const v = new " + s.name + "();\n"
  for $f in s.fields
    "  v." + $f.name + " = " + read_at($f.shape, $f.offset) + ";\n"
  end
  "  return v;\n}\n\n"
  "function write" + s.name + "(w: NinoWriter, at: number, v: " + s.name + "): void {\n"
  for $f in s.fields
    "  " + stmt(write_at($f.shape, $f.offset, "v." + $f.name)) + "\n"
  end
  "}\n\n"
end

for i in interfaces
  $self = i.self
  if i.members.size == 0 && i.parameters.size != 0
    # No member uses the parameters: "_" keeps noUnusedLocals quiet, and the type has no member a class must declare.
    $names = []
    for $p in i.parameters
      $names = array.add $names ("_" + $p)
    end
    $self = i.name + "<" + (array.join $names ", ") + ">"
  end
  "/** `" + (i.parameters.size == 0 ? i.model.full_name : i.model.runtime_name) + "`. */\nexport interface " + $self + " {\n"
  for $m in i.members
    "  " + $m.name + ": " + ts($m.shape) + ";\n"
  end
  "}\n\n"
end

for c in classes
  "/** `" + (c.parameters.size == 0 ? c.model.full_name : c.model.runtime_name) + "`. */\nexport " + (c.model.is_abstract ? "abstract " : "") + "class " + c.self
  if c.base_shape
    " extends " + generic_ts(c.base_shape)
  else if c.base_name
    " extends " + c.base_name
  end
  $interfaces = []
  for $i in c.interfaces
    $interfaces = array.add $interfaces ($i.shape ? generic_ts($i.shape) : $i.name)
  end
  if $interfaces.size != 0
    " implements " + (array.join $interfaces ", ")
  end
  " {\n"
  # A [NinoType] collection: its elements, written before its members.
  if c.declares_elements
    "  $elements: " + elements_ts(c.elements) + " = " + elements_def(c.elements) + ";\n"
  end
  # In a class hierarchy, V8 creates objects about twice as fast from constructors as from field initializers (one
  # initializer per class), so the members are declared and set in the constructor there.
  if !c.hierarchy
    for $m in c.own
      "  " + $m.name + ": " + ts($m.shape) + " = " + def($m.shape) + ";\n"
    end
  else if c.own.size != 0 || c.rebound.size != 0
    for $m in c.own
      "  declare " + $m.name + ": " + ts($m.shape) + ";\n"
    end
    "\n  constructor() {\n" + (c.base_name ? "    super();\n" : "")
    # Members of a generic base whose type this class gives: their defaults are this class's.
    for $m in c.rebound
      "    this." + $m.name + " = " + def($m.shape) + ";\n"
    end
    for $m in c.own
      "    this." + $m.name + " = " + def($m.shape) + ";\n"
    end
    "  }\n"
  end
  "}\n\n"
  if !c.model.is_abstract
    body(c)
  end
end

# Every type that can be written behind a type id, once its class is declared; a tracked one with its reference header
# after the id (`object` does not track).
for c in registered
  if c.raw_shape
    "types.add(" + c.model.type_id + ", " + c.name + ", (r) => " + read(c.raw_shape) + ", (w, v) => " + write(c.raw_shape, "v") + ");\n"
  else if c.tracked
    "types.add(" + c.model.type_id + ", " + c.name + ", (r) => " + read_body(c, true) + ", (w, v) => {\n  " + stmt(write_body(c, "v", true)) + "\n});\n"
  else
    "types.add(" + c.model.type_id + ", " + c.name + ", read" + c.name + ", write" + c.name + ");\n"
  end
end
"\n"

# A class per closed generic type a slot holds: TypeScript erases type arguments, writers switch on constructors.
for $k in slot_closed
  "/** `" + $k.runtime_name + "`. */\nexport class " + $k.name + " extends " + name($k.shape.type) + "<" + closed_args($k.shape) + "> {}\n\n"
end

# XCodec: the type with its header, as a member of its type or NinoSerializer writes it.
for c in codecs
  "export const " + c.name + "Codec: NinoCodec<" + c.name
  if c.header == "none" && c.raw_shape
    "> = {\n  read: (r) => " + read(c.raw_shape) + ",\n  write: (w, v) => " + write(c.raw_shape, "v") + ",\n};\n"
  else if c.header == "none"
    "> = { read: read" + c.name + ", write: write" + c.name + " };\n"
  else if c.header == "null"
    " | null> = {\n  read: (r) => " + read(c.header_shape) + ",\n  write: (w, v) => {\n    " + stmt(write(c.header_shape, "v")) + "\n  },\n};\n"
  else
    # Any type assignable to it, by the type id in front of its body: by its class when written.
    $backref = null
    if c.tracked
      $backref = c.model.is_interface ? "r.backRefOf<" + c.name + ">(h, [" + (array.join (c.assignable | array.map "name") ", ") + "])" : "r.backRef(h, " + c.name + ")"
    end
    " | null> = " + typeid_codec(c.assignable, c.assignable_closed, $backref)
  end
end

# XCodec(...) of a generic type: its codec from those of its type arguments, and the codecs it builds from them.
if generics.size != 0
  "\n"
end
for c in generics
  $self = c.self + (c.header == "null" ? " | null" : "")
  $params = []
  for $p in c.parameters
    $params = array.add $params ("p" + for.index + ": NinoCodec<" + $p + ">")
  end
  # The slots its codec is given: closed generic types behind type ids, whose ids its arguments' .NET names decide.
  $slots = c.slot_parameters
  for $sl in $slots
    $params = array.add $params ("s" + for.index + ": NinoCodec<" + ts($sl) + ">")
  end
  # A class written behind a type id is read through its slots: its codecs read its body, without a header.
  $typed = c.closed.size != 0 || c.header == "typeid"
  "interface " + c.name + "$Codecs" + c.type_params + " {\n"
  for $p in c.parameters
    "  p" + for.index + ": NinoCodec<" + $p + ">;\n"
  end
  for $sl in $slots
    "  s" + for.index + ": NinoCodec<" + ts($sl) + ">;\n"
  end
  if $typed
    "  type: new () => " + c.self + ";\n"
  end
  "  self: NinoCodec<" + $self + ">;\n"
  for $d in c.derived
    "  " + $d.name + ": NinoCodec<" + ts($d.shape) + ">;\n"
  end
  "}\n\n"
  $names = []
  for $p in c.parameters
    $names = array.add $names ("p" + for.index)
  end
  for $sl in $slots
    $names = array.add $names ("s" + for.index)
  end
  if $typed
    # `type`: the class it reads, a subclass for a closed type a slot holds (BoxInt32).
    if c.header != "typeid"
      "/** The codec of `" + c.model.runtime_name + "` with the codecs of its type arguments. */\n"
      "export function " + c.name + "Codec" + c.type_params + "(" + (array.join $params ", ") + ", type: new () => " + c.self + " = " + c.name + "): NinoCodec<" + $self + "> {\n"
      "  return " + c.name + "$codecs(" + (array.join $names ", ") + ", type).self;\n}\n\n"
    else
      "/** The codecs of the body of `" + c.model.runtime_name + "` with the codecs of its type arguments: a slot reads its closed types. */\n"
    end
    "function " + c.name + "$codecs" + c.type_params + "(" + (array.join $params ", ") + ", type: new () => " + c.self + "): " + c.name + "$Codecs" + c.type_params + " {\n"
    $names = array.add $names "type"
  else
    "/** The codec of `" + c.model.runtime_name + "` with the codecs of its type arguments. */\n"
    "export function " + c.name + "Codec" + c.type_params + "(" + (array.join $params ", ") + "): NinoCodec<" + $self + "> {\n"
  end
  "  const c = { " + (array.join $names ", ") + " } as " + c.name + "$Codecs" + c.type_params + ";\n"
  if c.header == "null"
    "  c.self = {\n    read: (r) => (r.notNull() ? read" + c.name + "(r, c) : null),\n    write: (w, v) => {\n      if (v === null || v === undefined) w.u8(0);\n      else {\n        w.u8(1);\n        write" + c.name + "(w, v, c);\n      }\n    },\n  };\n"
  else
    "  c.self = { read: (r) => read" + c.name + "(r, c), write: (w, v) => write" + c.name + "(w, v, c) };\n"
  end
  for $d in c.derived
    if c.lazy
      # It holds itself with other arguments: each codec is built when the data first needs it, as there is no end
      # to them.
      "  let " + $d.name + ": NinoCodec<" + ts($d.shape) + "> | undefined;\n"
      "  Object.defineProperty(c, \"" + $d.name + "\", { get: () => (" + $d.name + " ??= " + generic_codec($d.shape) + ") });\n"
    else
      "  c." + $d.name + " = " + generic_codec($d.shape) + ";\n"
    end
  end
  "  return " + ($typed ? "c" : "c.self") + ";\n}\n\n"
end

# The slots of closed generic types written behind type ids: a type id, then the body of a type assignable to it.
for $sl in slots
  "/** The slot of `" + $sl.runtime_name + "`. */\nconst " + $sl.name + ": NinoCodec<" + ts($sl.shape) + "> = " + typeid_codec($sl.assignable, $sl.closed, null) + "\n"
end

# The codecs of the generic types the types above hold with their arguments, arguments first.
for $d in closed
  if $d.subclass
    $g = generic_codec($d.shape)
    "const " + $d.name + " = " + (string.slice $g 0 ($g.size - 1)) + ", " + $d.subclass + ");\n"
  else
    "const " + $d.name + " = " + generic_codec($d.shape) + ";\n"
  end
end
if closed.size != 0
  "\n"
end

# The codecs of the closed generic types the slots hold, and the registry's entries for them.
for $k in slot_closed
  "const " + $k.codecs + " = " + name($k.shape.type) + "$codecs" + "<" + closed_args($k.shape) + ">(" + closed_codecs($k.shape) + ", " + $k.name + ");\n"
end
for $k in slot_closed
  "types.add(" + $k.id + ", " + $k.name + ", (r) => read" + name($k.shape.type) + "(r, " + $k.codecs + "), (w, v) => write" + name($k.shape.type) + "(w, v, " + $k.codecs + "));\n"
end
if slot_closed.size != 0
  "\n"
end

# The functions shared by values of one shape, in the order the code above first used them.
$i = 0
while $i < helper_count()
  helper_body(helper_at($i)) + "\n"
  $i = $i + 1
end
~}}
