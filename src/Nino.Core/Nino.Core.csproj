<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Nullable>disable</Nullable>
        <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
        <PackageId>Nino.Serialization</PackageId>
        <Description>The fastest binary serializer for C#. General-purpose, source-generated, zero-allocation and thread-safe: for services, RPC, messaging, caching and storage on .NET, with Unity, Godot and HybridCLR support.</Description>
        <PackageTags>Nino;Serialization;Binary</PackageTags>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Trim and NativeAOT safe: the analyzers check every build of the .NET targets (netstandard has no
         annotations to check; its builds compile the internal copies PolySharp generates, below). -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <!-- The .NET 8 reference assemblies do not mark RuntimeFeature.IsDynamicCodeSupported as a guard ([FeatureGuard]
         is .NET 9), so the analyzer flags the dynamic-code paths behind it, which NativeAOT 8 removes all the same.
         The net10.0 build compiles the same source with the guard understood. -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <NoWarn>$(NoWarn);IL3050</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedFiles Include="$(GeneratedAssemblyInfoFile)"/>
    </ItemGroup>

    <!-- The attributes the netstandard builds (Unity, .NET Framework) lack, as internal copies generated by PolySharp:
         the compiler, the trimmers and the analyzers match them by full name, so they are read like the framework's.
         Only these: SkipLocalsInit (Properties.cs) and the trimming and AOT annotations (with CompilerLoweringPreserve,
         which PolySharp's DynamicallyAccessedMembers carries). MULTI_TARGETING_SUPPORT_ATTRIBUTES keeps the
         annotations in the assembly's metadata, where a trimmer reads them (PolySharp marks them [Conditional] on it). -->
    <PropertyGroup>
        <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
        <PolySharpIncludeGeneratedTypes>System.Runtime.CompilerServices.SkipLocalsInitAttribute;System.Runtime.CompilerServices.CompilerLoweringPreserveAttribute;System.Diagnostics.CodeAnalysis.DynamicallyAccessedMembersAttribute;System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes;System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessageAttribute;System.Diagnostics.CodeAnalysis.RequiresDynamicCodeAttribute</PolySharpIncludeGeneratedTypes>
        <DefineConstants>$(DefineConstants);MULTI_TARGETING_SUPPORT_ATTRIBUTES</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PolySharp" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="System.Buffers"/>
        <PackageReference Include="System.Memory"/>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe"/>
    </ItemGroup>

</Project>
