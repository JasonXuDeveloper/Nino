<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <IsRoslynComponent>true</IsRoslynComponent>
        <RootNamespace>Nino.Generator</RootNamespace>
        <PackageId>Nino.Generator</PackageId>
        <!-- An analyzer package: nothing goes to lib/, so consumers never compile against Roslyn. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <Description>Source generator, analyzers and code fixes of Nino, a high-performance binary serializer for .NET.</Description>
        <PackageTags>Nino;Serialization;Binary;Generator</PackageTags>
        <AnalyzerLanguage>cs</AnalyzerLanguage>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Selects the namespace of the sources shared with Nino.Core. -->
        <DefineConstants>$(DefineConstants);NINO_GENERATOR</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Version.cs"/>
        <!-- Shared with Nino.Core so compile-time and run-time rules (ids, wire constants, layouts, formatter binding)
             cannot drift apart. -->
        <Compile Include="..\Nino.Core\Internal\NinoHash.cs" Link="Shared\NinoHash.cs"/>
        <Compile Include="..\Nino.Core\Internal\NinoLayoutCore.cs" Link="Shared\NinoLayoutCore.cs"/>
        <Compile Include="..\Nino.Core\IO\NinoWire.cs" Link="Shared\NinoWire.cs"/>
        <Compile Include="..\Nino.Core\Internal\NinoFormatterBinding.cs" Link="Shared\NinoFormatterBinding.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Built against Roslyn 4.3 (the oldest Unity supports): the versioned folder makes NuGet skip compilers
         older than that instead of loading an analyzer they cannot run. Code fixes ship next to it. -->
    <ItemGroup>
        <ProjectReference Include="..\Nino.Generator.CodeFixes\Nino.Generator.CodeFixes.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"/>
        <!-- The same sources built against Roslyn 4.8 and 4.12, with interceptors; NuGet loads the newest build the
             compiler can run. -->
        <ProjectReference Include="..\Nino.Generator.Roslyn4.8\Nino.Generator.Roslyn4.8.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"/>
        <ProjectReference Include="..\Nino.Generator.Roslyn4.12\Nino.Generator.Roslyn4.12.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.3/cs" Visible="false"/>
        <None Include="..\Nino.Generator.Roslyn4.8\bin\$(Configuration)\netstandard2.0\Nino.Generator.dll"
              Pack="true" PackagePath="analyzers/dotnet/roslyn4.8/cs" Visible="false"/>
        <None Include="..\Nino.Generator.CodeFixes\bin\$(Configuration)\netstandard2.0\Nino.Generator.CodeFixes.dll"
              Pack="true" PackagePath="analyzers/dotnet/roslyn4.8/cs" Visible="false"/>
        <None Include="..\Nino.Generator.Roslyn4.12\bin\$(Configuration)\netstandard2.0\Nino.Generator.dll"
              Pack="true" PackagePath="analyzers/dotnet/roslyn4.12/cs" Visible="false"/>
        <None Include="..\Nino.Generator.CodeFixes\bin\$(Configuration)\netstandard2.0\Nino.Generator.CodeFixes.dll"
              Pack="true" PackagePath="analyzers/dotnet/roslyn4.12/cs" Visible="false"/>
        <None Include="build\Nino.Generator.props" Pack="true" PackagePath="build;buildTransitive"/>
        <None Include="..\Nino.Generator.CodeFixes\bin\$(Configuration)\netstandard2.0\Nino.Generator.CodeFixes.dll"
              Pack="true" PackagePath="analyzers/dotnet/roslyn4.3/cs" Visible="false"/>
    </ItemGroup>

</Project>