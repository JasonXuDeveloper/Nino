<Project Sdk="Microsoft.NET.Sdk">

    <!-- The generator built against Roslyn 4.3 (the oldest Unity supports), and the Nino.Generator package: this
         build, the Roslyn 4.8 and 4.12 builds and the code fixes, each in the versioned analyzer folder NuGet picks
         by compiler version (older compilers skip an analyzer they cannot run). -->
    <PropertyGroup>
        <NinoRoslynVersion>4.3</NinoRoslynVersion>
    </PropertyGroup>
    <Import Project="Generator.Build.props"/>

    <PropertyGroup>
        <PackageId>Nino.Generator</PackageId>
        <Description>Source generator, analyzers and code fixes of Nino, a high-performance binary serializer for .NET.</Description>
        <PackageTags>Nino;Serialization;Binary;Generator</PackageTags>
        <!-- An analyzer package: nothing goes to lib/, so consumers never compile against Roslyn. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <AnalyzerLanguage>cs</AnalyzerLanguage>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    </PropertyGroup>

    <!-- Built first; NinoPackagePath is where each one's DLL goes in the package. -->
    <ItemGroup>
        <ProjectReference Include="..\Nino.Generator.CodeFixes\Nino.Generator.CodeFixes.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"
                          NinoPackagePath="analyzers/dotnet/roslyn4.3/cs;analyzers/dotnet/roslyn4.8/cs;analyzers/dotnet/roslyn4.12/cs"/>
        <ProjectReference Include="..\Nino.Generator.Roslyn4.8\Nino.Generator.Roslyn4.8.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"
                          NinoPackagePath="analyzers/dotnet/roslyn4.8/cs"/>
        <ProjectReference Include="..\Nino.Generator.Roslyn4.12\Nino.Generator.Roslyn4.12.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"
                          NinoPackagePath="analyzers/dotnet/roslyn4.12/cs"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/roslyn4.3/cs" Visible="false"/>
        <None Include="build\Nino.Generator.props" Pack="true" PackagePath="build;buildTransitive"/>
    </ItemGroup>

    <!-- The other builds' DLLs, wherever their projects put them (GetTargetPath builds nothing, so pack -no-build
         works). Batched per project (Outputs) to keep each DLL with its NinoPackagePath. -->
    <Target Name="NinoPackAnalyzers" BeforeTargets="_GetPackageFiles" Outputs="%(ProjectReference.Identity)">
        <MSBuild Projects="@(ProjectReference)" Targets="GetTargetPath"
                 Condition="'%(ProjectReference.NinoPackagePath)' != ''">
            <Output TaskParameter="TargetOutputs" ItemName="_NinoAnalyzerDll"/>
        </MSBuild>
        <ItemGroup>
            <None Include="@(_NinoAnalyzerDll)" Pack="true" PackagePath="%(ProjectReference.NinoPackagePath)" Visible="false"
                  Condition="'%(ProjectReference.NinoPackagePath)' != ''"/>
            <_NinoAnalyzerDll Remove="@(_NinoAnalyzerDll)"/>
        </ItemGroup>
    </Target>

</Project>
