<Project>
    <!-- Lets the generator intercept top-level NinoSerializer/NinoDeserializer calls (compilers that load its
         Roslyn 4.8 or 4.12 build: .NET 8 SDK and later), so they call the formatter directly. Always on; a project
         that sets either property itself must append to it. Roslyn 4.8-4.11 read InterceptorsPreviewNamespaces;
         later compilers read both. -->
    <PropertyGroup>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);NinoGen</InterceptorsNamespaces>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);NinoGen</InterceptorsPreviewNamespaces>
    </PropertyGroup>

    <!-- <NinoPrefetchLargeCollections>true</NinoPrefetchLargeCollections> makes the intercepted top-level calls of
         arrays and lists of classes prefetch long collections of scattered objects (off by default; the generated
         code is then what it is without it). -->
    <ItemGroup>
        <CompilerVisibleProperty Include="NinoPrefetchLargeCollections"/>
    </ItemGroup>
</Project>
