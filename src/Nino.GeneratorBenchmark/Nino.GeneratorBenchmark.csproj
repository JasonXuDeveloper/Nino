<Project Sdk="Microsoft.NET.Sdk">
  <!-- Measures the source generator and analyzer: see docs/v4-benchmarks.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../Nino.Generator/Nino.Generator.csproj" />
    <ProjectReference Include="../Nino.Core/Nino.Core.csproj" SetTargetFramework="TargetFramework=net8.0" />
  </ItemGroup>
</Project>
