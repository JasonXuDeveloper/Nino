<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Run by the build (build/Nino.TypeScript.targets) with whatever .NET runtime the SDK has, 8.0 or later. -->
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>LatestMajor</RollForward>
        <AssemblyName>nino-ts</AssemblyName>
        <RootNamespace>Nino.TypeScript</RootNamespace>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <PackageId>Nino.TypeScript</PackageId>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Title>Nino.TypeScript</Title>
        <Authors>JasonXuDeveloper</Authors>
        <Description>TypeScript for Nino: after each build, writes TypeScript classes and codecs that read and write the bytes the project's [NinoType]s are serialized to, read from the layouts the Nino generator published in the built assembly, plus the nino.ts runtime.</Description>
        <Copyright>JasonXuDeveloper</Copyright>
        <RepositoryUrl>https://github.com/JasonXuDeveloper/Nino</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Nino;Serialization;Binary;TypeScript;JavaScript;CodeGeneration</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://nino.xgamedev.net/</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <!-- A build tool: no lib/ assets, nothing flows to the project's dependents. -->
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nino.TypeScript.Tests"/>
        <EmbeddedResource Include="Runtime\nino.ts" LogicalName="nino.ts"/>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\docs\assets\logo.png" Pack="true" PackagePath="icon.png" Visible="false"/>
        <None Include="build\Nino.TypeScript.targets" Pack="true" PackagePath="build\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.13"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" PrivateAssets="All"/>
    </ItemGroup>

    <!-- The tool and its dependencies go to tools/ in the package, where the targets run it from. -->
    <Target Name="PackTool" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <None Include="$(OutputPath)nino-ts.dll;$(OutputPath)System.Reflection.MetadataLoadContext.dll;$(OutputPath)nino-ts.runtimeconfig.json;$(OutputPath)nino-ts.deps.json"
                  Pack="true" PackagePath="tools"/>
        </ItemGroup>
    </Target>

</Project>
