<Project Sdk="Microsoft.NET.Sdk">

    <!-- The generator built against Roslyn 4.12 (.NET 9 SDK and later): the same sources as Nino.Generator, plus
         interceptors for the top-level NinoSerializer/NinoDeserializer calls (ROSLYN4_8 and ROSLYN4_12: the stable
         [InterceptsLocation(version, data)] form). Packed by Nino.Generator into analyzers/dotnet/roslyn4.12/cs, which
         NuGet prefers on compilers that can load it; Roslyn 4.8-4.11 load the Roslyn 4.8 build, older compilers (and
         Unity) the Roslyn 4.3 one. -->
    <PropertyGroup>
        <NinoRoslynVersion>4.12</NinoRoslynVersion>
    </PropertyGroup>
    <Import Project="..\Nino.Generator\Generator.Build.props"/>

</Project>
