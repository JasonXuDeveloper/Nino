<Project Sdk="Microsoft.NET.Sdk">

    <!-- The generator built against Roslyn 4.8 (.NET 8 SDK): the same sources as Nino.Generator, plus interceptors
         for the top-level NinoSerializer/NinoDeserializer calls in their preview form ([InterceptsLocation(path,
         line, column)], ROSLYN4_8). Packed by Nino.Generator into analyzers/dotnet/roslyn4.8/cs, which NuGet picks
         on Roslyn 4.8-4.11; newer compilers load the Roslyn 4.12 build, older ones (and Unity) the Roslyn 4.3 one. -->
    <PropertyGroup>
        <NinoRoslynVersion>4.8</NinoRoslynVersion>
    </PropertyGroup>
    <Import Project="..\Nino.Generator\Generator.Build.props"/>

</Project>
