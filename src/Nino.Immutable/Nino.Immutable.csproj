<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <PackageId>Nino.Immutable</PackageId>
        <Description>Nino formatters for System.Collections.Immutable (ImmutableArray, ImmutableList, ImmutableHashSet, ImmutableSortedSet, ImmutableQueue, ImmutableStack, ImmutableDictionary, ImmutableSortedDictionary).</Description>
        <PackageTags>Nino;Serialization;Binary;Immutable</PackageTags>
        <!-- [module: SkipLocalsInit] (Properties.cs) needs it. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Trim and NativeAOT safe, like Nino.Core: the analyzers check the net8.0 build (netstandard has no
         annotations to check). -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Nino.Core\Internal\ObjectTypes.cs" Link="ObjectTypes.cs"/>
    </ItemGroup>

    <!-- SkipLocalsInit (Properties.cs) for the netstandard build, as an internal copy generated by PolySharp. -->
    <PropertyGroup>
        <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
        <PolySharpIncludeGeneratedTypes>System.Runtime.CompilerServices.SkipLocalsInitAttribute</PolySharpIncludeGeneratedTypes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PolySharp" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Build with -p:NinoCoreTfm=netstandard2.0 (or netstandard2.1) to test a specific Nino.Core build. -->
        <ProjectReference Include="..\Nino.Core\Nino.Core.csproj" Condition="'$(NinoCoreTfm)' == ''"/>
        <ProjectReference Include="..\Nino.Core\Nino.Core.csproj" Condition="'$(NinoCoreTfm)' != ''"
                          SetTargetFramework="TargetFramework=$(NinoCoreTfm)"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Collections.Immutable"/>
    </ItemGroup>

</Project>
